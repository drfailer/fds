&HEAD CHID='dancing_eddies_22mesh_2mpi', TITLE='22-Mesh Dancing Eddies - 2 MPI processes'/

&MESH IJK=15,1,40, XB=0.000,0.015,-0.001,0.001,-0.02,0.020, MPI_PROCESS=0 /
&MESH IJK=15,1,40, XB=0.015,0.030,-0.001,0.001,-0.02,0.020, MPI_PROCESS=0 /
&MESH IJK=15,1,40, XB=0.030,0.045,-0.001,0.001,-0.02,0.020, MPI_PROCESS=0 /
&MESH IJK=15,1,40, XB=0.045,0.060,-0.001,0.001,-0.02,0.020, MPI_PROCESS=0 /
&MESH IJK=15,1,40, XB=0.060,0.075,-0.001,0.001,-0.02,0.020, MPI_PROCESS=0 /
&MESH IJK=15,1,40, XB=0.075,0.090,-0.001,0.001,-0.02,0.020, MPI_PROCESS=0 /
&MESH IJK=15,1,40, XB=0.090,0.105,-0.001,0.001,-0.02,0.020, MPI_PROCESS=0 /
&MESH IJK=15,1,40, XB=0.105,0.120,-0.001,0.001,-0.02,0.020, MPI_PROCESS=0 /
&MESH IJK=15,1,40, XB=0.120,0.135,-0.001,0.001,-0.02,0.020, MPI_PROCESS=0 /
&MESH IJK=15,1,40, XB=0.135,0.150,-0.001,0.001,-0.02,0.020, MPI_PROCESS=0 /
&MESH IJK=15,1,40, XB=0.150,0.165,-0.001,0.001,-0.02,0.020, MPI_PROCESS=0 /
&MESH IJK=15,1,40, XB=0.165,0.180,-0.001,0.001,-0.02,0.020, MPI_PROCESS=1 /
&MESH IJK=15,1,40, XB=0.180,0.195,-0.001,0.001,-0.02,0.020, MPI_PROCESS=1 /
&MESH IJK=15,1,40, XB=0.195,0.210,-0.001,0.001,-0.02,0.020, MPI_PROCESS=1 /
&MESH IJK=15,1,40, XB=0.210,0.225,-0.001,0.001,-0.02,0.020, MPI_PROCESS=1 /
&MESH IJK=15,1,40, XB=0.225,0.240,-0.001,0.001,-0.02,0.020, MPI_PROCESS=1 /
&MESH IJK=15,1,40, XB=0.240,0.255,-0.001,0.001,-0.02,0.020, MPI_PROCESS=1 /
&MESH IJK=15,1,40, XB=0.255,0.270,-0.001,0.001,-0.02,0.020, MPI_PROCESS=1 /
&MESH IJK=15,1,40, XB=0.270,0.285,-0.001,0.001,-0.02,0.020, MPI_PROCESS=1 /
&MESH IJK=15,1,40, XB=0.285,0.300,-0.001,0.001,-0.02,0.020, MPI_PROCESS=1 /
&MESH IJK=15,1,40, XB=0.300,0.315,-0.001,0.001,-0.02,0.020, MPI_PROCESS=1 /
&MESH IJK=15,1,40, XB=0.315,0.330,-0.001,0.001,-0.02,0.020, MPI_PROCESS=1 /

&TIME T_END=0.1 /

&MISC SIMULATION_MODE='DNS', STRATIFICATION=.FALSE., NOISE=.FALSE. /

&PRES CHECK_POISSON=T /

&SPEC ID='LJ AIR', VISCOSITY=1.2E-5, BACKGROUND=.TRUE. /

&SURF ID='WALL', FREE_SLIP=.TRUE., DEFAULT=.TRUE. /
&SURF ID='PLATE', NO_SLIP=.TRUE. /

&OBST XB=0.020,0.021,-0.001,0.001, 0.004,0.005, SURF_ID='PLATE' /
&OBST XB=0.100,0.102,-0.001,0.001,-0.005,0.005, SURF_ID='PLATE' /

&SURF ID='BLOW', VEL=-0.5 /

&VENT PBX=0.0, SURF_ID='BLOW' /
&VENT PBX=0.33, SURF_ID='OPEN' /

&SLCF PBY=0.,QUANTITY='VELOCITY',VECTOR=.TRUE. /

&DEVC XYZ=0.2,0.,0.0, QUANTITY='PRESSURE', ID='pres' /
&DEVC XYZ=0.,0.,0.,   QUANTITY='MAXIMUM VELOCITY ERROR', ID='error' /
&DEVC XYZ=0.,0.,0.,   QUANTITY='PRESSURE ITERATIONS', ID='iter' /

&TAIL /
