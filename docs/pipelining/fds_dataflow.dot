// FDS Time-Stepping Data-Flow Dependency Graph
// Generated from analysis of main.f90, velo*.f90, divg*.f90, mass*.f90, pres*.f90,
// turb.f90, wall.f90, fire.f90, part.f90, radi.f90
//
// DATA CATEGORIES (mesh-level arrays):
//   vel       = U, V, W              (current velocity)
//   vel_s     = US, VS, WS           (estimated/predicted velocity)
//   flux      = FVX, FVY, FVZ        (momentum flux terms, includes baroclinic FVX_B etc.)
//   drag      = FVX_D, FVY_D, FVZ_D  (particle drag forces on gas)
//   pres      = H                     (current pressure head)
//   pres_s    = HS                    (estimated pressure head)
//   div       = D                     (current divergence)
//   div_s     = DS                    (estimated divergence)
//   dddt      = DDDT                  (dD/dt time derivative)
//   species   = ZZ                    (current species mass fractions, 4D)
//   species_s = ZZS                   (estimated species, 4D)
//   rho       = RHO                   (current density)
//   rho_s     = RHOS                  (estimated density)
//   temp      = TMP                   (temperature)
//   visc      = MU, KRES             (viscosity, kinetic energy)
//   energy    = Q, M_DOT_PPP          (energy source, mass production rate)
//   qr        = QR                    (radiation source term)
//   pbar      = PBAR_S, D_PBAR_DT_S  (predictor pressure zone data)
//   pbar_c    = PBAR, D_PBAR_DT      (corrector pressure zone data)
//   wall      = WALL(:), BCs         (wall/boundary cell data)
//   part      = LAGRANGIAN_PARTICLE   (Lagrangian particles)
//   diff      = DEL_RHO_D_DEL_Z      (species diffusion fluxes, 4D)
//   dsum      = DSUM, PSUM, USUM     (pressure zone integrals, global)
//   edge      = EDGE(:)              (edge viscous stress/vorticity)
//
// EDGE SEMANTICS: A -> B means A writes data that B reads.
// Edge labels show what data flows. Multiple labels = multiple dependencies.

digraph FDS_Dataflow {
    rankdir=TB;
    compound=true;
    fontname="Helvetica";
    node [fontname="Helvetica", fontsize=10];
    edge [fontname="Helvetica", fontsize=8];
    newrank=true;

    // =====================================================================
    //  LEGEND
    // =====================================================================
    subgraph cluster_legend {
        label="Data Categories";
        style=dashed;
        color=gray;
        fontsize=12;
        node [shape=plaintext, fontsize=9];

        legend [label=<
        <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4">
        <TR><TD BGCOLOR="lightblue"><B>vel</B></TD>    <TD>U, V, W</TD></TR>
        <TR><TD BGCOLOR="lightblue"><B>vel_s</B></TD>  <TD>US, VS, WS</TD></TR>
        <TR><TD BGCOLOR="lightyellow"><B>flux</B></TD>  <TD>FVX, FVY, FVZ (+ baroclinic)</TD></TR>
        <TR><TD BGCOLOR="lightyellow"><B>drag</B></TD>  <TD>FVX_D, FVY_D, FVZ_D</TD></TR>
        <TR><TD BGCOLOR="lightgreen"><B>pres</B></TD>   <TD>H (pressure head)</TD></TR>
        <TR><TD BGCOLOR="lightgreen"><B>pres_s</B></TD> <TD>HS (estimated pressure)</TD></TR>
        <TR><TD BGCOLOR="lightsalmon"><B>div</B></TD>   <TD>D (divergence)</TD></TR>
        <TR><TD BGCOLOR="lightsalmon"><B>div_s</B></TD> <TD>DS (estimated divergence)</TD></TR>
        <TR><TD BGCOLOR="lightsalmon"><B>dddt</B></TD>  <TD>DDDT (dD/dt)</TD></TR>
        <TR><TD BGCOLOR="plum"><B>species</B></TD>      <TD>ZZ (mass fractions)</TD></TR>
        <TR><TD BGCOLOR="plum"><B>species_s</B></TD>    <TD>ZZS (estimated)</TD></TR>
        <TR><TD BGCOLOR="plum"><B>rho</B></TD>          <TD>RHO (density)</TD></TR>
        <TR><TD BGCOLOR="plum"><B>rho_s</B></TD>        <TD>RHOS (estimated)</TD></TR>
        <TR><TD BGCOLOR="wheat"><B>temp</B></TD>        <TD>TMP (temperature)</TD></TR>
        <TR><TD BGCOLOR="wheat"><B>visc</B></TD>        <TD>MU, KRES (viscosity)</TD></TR>
        <TR><TD BGCOLOR="wheat"><B>diff</B></TD>        <TD>DEL_RHO_D_DEL_Z</TD></TR>
        <TR><TD BGCOLOR="mistyrose"><B>energy</B></TD>  <TD>Q, M_DOT_PPP</TD></TR>
        <TR><TD BGCOLOR="mistyrose"><B>qr</B></TD>      <TD>QR (radiation)</TD></TR>
        <TR><TD BGCOLOR="khaki"><B>pbar</B></TD>        <TD>PBAR_S, D_PBAR_DT_S</TD></TR>
        <TR><TD BGCOLOR="khaki"><B>dsum</B></TD>        <TD>DSUM, PSUM, USUM (global)</TD></TR>
        <TR><TD BGCOLOR="lightgray"><B>wall</B></TD>    <TD>WALL(:), boundary cells</TD></TR>
        <TR><TD BGCOLOR="lightgray"><B>edge</B></TD>    <TD>EDGE(:) (stress/vorticity)</TD></TR>
        <TR><TD BGCOLOR="lightcyan"><B>part</B></TD>    <TD>LAGRANGIAN_PARTICLE</TD></TR>
        </TABLE>
        >];
    }

    // =====================================================================
    //  PREDICTOR PHASE
    // =====================================================================
    subgraph cluster_predictor {
        label="PREDICTOR Phase";
        style=filled;
        color=lightblue;
        fillcolor="#e8f4fd";
        fontsize=14;

        // --- Nodes ---
        // Shape: box=kernel, diamond=barrier, octagon=exchange
        P_INSERT [label="INSERT_PARTICLES\n(sequential)", shape=box, style=filled, fillcolor=lightyellow];
        P_VISC   [label="COMPUTE_VISCOSITY\n(parallel)", shape=box, style=filled, fillcolor=lightgreen];
        P_MASSFD [label="MASS_FINITE_DIFF\n(parallel)", shape=box, style=filled, fillcolor=lightgreen];
        P_DENS   [label="DENSITY\n(parallel)", shape=box, style=filled, fillcolor=lightgreen];
        P_EX1    [label="MESH_EXCHANGE(1)\nspecies_s, rho_s", shape=octagon, style=filled, fillcolor=lightsalmon];
        P_VFLUX  [label="VISCOSITY_BC +\nVELOCITY_FLUX\n(parallel)", shape=box, style=filled, fillcolor=lightgreen];
        P_HVAC   [label="HVAC + InitDiv\n(barrier)", shape=diamond, style=filled, fillcolor=lightsalmon];
        P_WALLBC [label="WALL_BC\n(parallel)", shape=box, style=filled, fillcolor=lightgreen];
        P_PARTMOM [label="PARTICLE_MOMENTUM\n(parallel)", shape=box, style=filled, fillcolor=lightgreen];
        P_DIVP1  [label="DIVERGENCE_PART_1\n(parallel)", shape=box, style=filled, fillcolor=lightgreen];
        P_DIVEX  [label="DIV_EXCHANGE\n(barrier: DSUM/PSUM/USUM)", shape=diamond, style=filled, fillcolor=lightsalmon];
        P_DIVP2  [label="DIVERGENCE_PART_2\n(parallel)", shape=box, style=filled, fillcolor=lightgreen];
        P_PRES   [label="PRESSURE_SOLVE\n(parallel per mesh)", shape=box, style=filled, fillcolor=lightgreen];
        P_VELPRED [label="VELOCITY_PREDICTOR\n(parallel)", shape=box, style=filled, fillcolor=lightgreen];
        P_CFL    [label="CHECK_STABILITY\nCHANGE_TIME_STEP", shape=diamond, style=filled, fillcolor=lightsalmon];
        P_EX3    [label="MESH_EXCHANGE(3)\nvel_s, pres", shape=octagon, style=filled, fillcolor=lightsalmon];
        P_VELBC  [label="MATCH_VELOCITY +\nVELOCITY_BC", shape=box, style=filled, fillcolor=lightyellow];

        // --- Data-flow edges ---

        // INSERT -> VISC (part data set, but VISC doesn't need part)
        // VISC needs vel, rho, species, temp from previous corrector
        P_INSERT -> P_VISC [label="part", style=dashed, color=gray];

        // VISC -> MASSFD: visc output needed
        P_VISC -> P_MASSFD [label="visc"];

        // MASSFD -> DENS: diff output needed
        P_MASSFD -> P_DENS [label="diff"];

        // DENS -> EX1: produces rho_s, species_s, temp
        P_DENS -> P_EX1 [label="rho_s, species_s,\ntemp"];

        // After EX1: two independent branches diverge
        // Branch A: VELOCITY_FLUX
        P_EX1 -> P_VFLUX [label="vel, rho, visc,\ndiv, edge"];
        P_EX1 -> P_HVAC [label="(HVAC_BC_IN\nalready done)", style=dashed, color=gray];

        // Branch B: WALL_BC -> PART_MOM -> DIV_P1
        P_HVAC -> P_WALLBC [label="(InitDiv zeros\nDSUM/PSUM/USUM)"];
        P_EX1 -> P_WALLBC [label="rho_s, species_s,\ntemp, vel, wall", style=dashed];

        P_WALLBC -> P_PARTMOM [label="(wall done,\npart available)", style=dashed, color=gray];
        P_WALLBC -> P_DIVP1 [label="energy, pbar,\ntemp(boundary),\nwall"];
        P_PARTMOM -> P_DIVP1 [label="(drag written,\nnot read by DIV_P1)", style=dashed, color=gray];

        // DIV_P1 also reads: rho_s, species_s, temp, visc, diff, qr
        // These are from earlier steps, not from VFLUX
        P_DIVP1 -> P_DIVEX [label="dsum\n(D_SUM_LOC, etc.)"];

        // DIV_EXCHANGE -> DIV_P2
        P_DIVEX -> P_DIVP2 [label="div_s, dsum"];

        // VFLUX joins at DIV_P2 (needs flux for PRHS)
        P_VFLUX -> P_DIVP2 [label="flux\n(for PRHS)", color=red, penwidth=2];

        // DIV_P2 -> PRESSURE
        P_DIVP2 -> P_PRES [label="dddt, div_s,\npbar"];

        // PRESSURE -> VEL_PRED
        P_PRES -> P_VELPRED [label="pres (H)"];
        // VFLUX also needed by VEL_PRED
        P_VFLUX -> P_VELPRED [label="flux\n(US=U-DT*(FVX+dH/dx))", color=red, penwidth=2];

        // VEL_PRED -> CFL -> EX3 -> VELBC
        P_VELPRED -> P_CFL [label="vel_s"];
        P_CFL -> P_EX3 [label="vel_s, pres"];
        P_EX3 -> P_VELBC [label="vel_s"];
    }

    // =====================================================================
    //  CORRECTOR PHASE
    // =====================================================================
    subgraph cluster_corrector {
        label="CORRECTOR Phase";
        style=filled;
        color=lightyellow;
        fillcolor="#fdf8e8";
        fontsize=14;

        // --- Nodes ---
        C_VISC    [label="COMPUTE_VISCOSITY\n(parallel)", shape=box, style=filled, fillcolor=lightgreen];
        C_MASSFD  [label="MASS_FINITE_DIFF\n(parallel)", shape=box, style=filled, fillcolor=lightgreen];
        C_DENS    [label="DENSITY\n(parallel)", shape=box, style=filled, fillcolor=lightgreen];
        C_EX4     [label="MESH_EXCHANGE(4)\nspecies, rho", shape=octagon, style=filled, fillcolor=lightsalmon];
        C_VFLUX   [label="VISCOSITY_BC +\nVELOCITY_FLUX\n(parallel)", shape=box, style=filled, fillcolor=lightgreen];
        C_COMB    [label="COMBUSTION\n(parallel)", shape=box, style=filled, fillcolor=lightgreen];
        C_COND    [label="CONDENSATION\n(parallel)", shape=box, style=filled, fillcolor=lightyellow];
        C_PMENRG  [label="PARTICLE_MASS_ENERGY\n(parallel)", shape=box, style=filled, fillcolor=lightgreen];
        C_MOVE    [label="MOVE_PARTICLES\n(sequential barrier)", shape=diamond, style=filled, fillcolor=lightsalmon];
        C_PARTMOM [label="PARTICLE_MOMENTUM\n(parallel)", shape=box, style=filled, fillcolor=lightgreen];
        C_EX7     [label="MESH_EXCHANGE(7)\nparticles", shape=octagon, style=filled, fillcolor=lightsalmon];
        C_WALLBC  [label="WALL_BC\n(parallel)", shape=box, style=filled, fillcolor=lightgreen];
        C_EX6a    [label="MESH_EXCHANGE(6)\nwall/3D HT", shape=octagon, style=filled, fillcolor=lightsalmon];
        C_RADI    [label="COMPUTE_RADIATION\n(parallel)", shape=box, style=filled, fillcolor=lightgreen];
        C_EX2     [label="MESH_EXCHANGE(2)\nradiation + InitDiv", shape=octagon, style=filled, fillcolor=lightsalmon];
        C_DIVP1   [label="COMBUSTION_BC +\nDIVERGENCE_PART_1\n(parallel)", shape=box, style=filled, fillcolor=lightgreen];
        C_DIVEX   [label="DIV_EXCHANGE\n(barrier: DSUM/PSUM/USUM)", shape=diamond, style=filled, fillcolor=lightsalmon];
        C_DIVP2   [label="DIVERGENCE_PART_2\n(parallel)", shape=box, style=filled, fillcolor=lightgreen];
        C_PRES    [label="PRESSURE_SOLVE\n(parallel per mesh)", shape=box, style=filled, fillcolor=lightgreen];
        C_VELCORR [label="VELOCITY_CORRECTOR\n(parallel)", shape=box, style=filled, fillcolor=lightgreen];
        C_EX6b    [label="MESH_EXCHANGE(6)\nvel, pres_s", shape=octagon, style=filled, fillcolor=lightsalmon];
        C_VELBC   [label="MATCH_VELOCITY +\nVELOCITY_BC", shape=box, style=filled, fillcolor=lightyellow];
        C_DUMP    [label="UPDATE_OUTPUTS +\nDUMP", shape=box, style=filled, fillcolor=lightgray];

        // --- Sequential chain: VISC -> MASSFD -> DENS -> EX4 ---
        C_VISC -> C_MASSFD [label="visc"];
        C_MASSFD -> C_DENS [label="diff"];
        C_DENS -> C_EX4 [label="rho, species,\ntemp"];

        // --- After EX4: TWO INDEPENDENT BRANCHES ---

        // Branch A: VELOCITY_FLUX (short, fast)
        C_EX4 -> C_VFLUX [label="vel_s, rho_s,\nvisc, div_s, edge"];

        // Branch B: Long chain (combustion -> particles -> wall -> radiation -> div_p1)
        C_EX4 -> C_COMB [label="species, rho,\ntemp"];
        C_COMB -> C_COND [label="species (updated),\nenergy"];
        C_COND -> C_PMENRG [label="species"];
        C_PMENRG -> C_MOVE [label="energy, part"];
        C_MOVE -> C_PARTMOM [label="part (moved)"];
        C_PARTMOM -> C_EX7 [label="drag, part"];
        C_EX7 -> C_WALLBC [label="part(exchanged)"];
        C_WALLBC -> C_EX6a [label="energy, pbar,\ntemp(boundary),\nwall"];
        C_EX6a -> C_RADI [label="temp, rho,\nspecies, wall"];
        C_RADI -> C_EX2 [label="qr"];
        C_EX2 -> C_DIVP1 [label="qr, energy,\npbar, species,\nrho, temp, visc, diff"];
        C_DIVP1 -> C_DIVEX [label="dsum"];
        C_DIVEX -> C_DIVP2 [label="div, dsum"];

        // JOIN: VELOCITY_FLUX output needed by DIV_P2 (for PRHS) and VEL_CORRECTOR
        C_VFLUX -> C_DIVP2 [label="flux\n(for PRHS)", color=red, penwidth=2];

        // DIV_P2 -> PRESSURE -> VEL_CORRECTOR
        C_DIVP2 -> C_PRES [label="dddt, div,\npbar"];
        C_PRES -> C_VELCORR [label="pres_s (HS)"];
        C_VFLUX -> C_VELCORR [label="flux\n(U=0.5*(U+US-DT*(FVX+dHS/dx)))", color=red, penwidth=2];

        // VEL_CORRECTOR -> EX6b -> VELBC -> DUMP
        C_VELCORR -> C_EX6b [label="vel, pres_s"];
        C_EX6b -> C_VELBC [label="vel"];
        C_VELBC -> C_DUMP [label="vel, temp,\nspecies, rho"];
    }

    // =====================================================================
    //  PHASE TRANSITION (predictor -> corrector -> next timestep)
    // =====================================================================
    P_VELBC -> C_VISC [label="vel_s (as input\nto corrector)", style=bold, color=blue];
    C_DUMP -> P_INSERT [label="vel, rho, species,\ntemp, pres, pres_s\n(carry to next timestep)", style=bold, color=blue];

    // =====================================================================
    //  ANNOTATIONS: Pipelining Opportunities
    // =====================================================================
    subgraph cluster_pipeline_pred {
        label="PREDICTOR Pipelining Opportunity";
        style=dashed;
        color=red;
        fontsize=11;
        fontcolor=red;

        pipeline_pred [shape=plaintext, fontsize=9, label=<
        <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0">
        <TR><TD ALIGN="LEFT"><B>After MESH_EXCHANGE(1):</B></TD></TR>
        <TR><TD ALIGN="LEFT">Branch A: VELOCITY_FLUX (writes flux)</TD></TR>
        <TR><TD ALIGN="LEFT">Branch B: WALL_BC → PART_MOM → DIV_P1 (writes div_s, dsum)</TD></TR>
        <TR><TD ALIGN="LEFT">Join at: DIV_PART_2 (needs flux + div_s + DDDT)</TD></TR>
        <TR><TD ALIGN="LEFT"> </TD></TR>
        <TR><TD ALIGN="LEFT"><B>No data conflicts:</B></TD></TR>
        <TR><TD ALIGN="LEFT">VELOCITY_FLUX reads: vel, rho, visc, div, edge</TD></TR>
        <TR><TD ALIGN="LEFT">WALL_BC reads: vel, rho_s, species_s, temp, wall</TD></TR>
        <TR><TD ALIGN="LEFT">VELOCITY_FLUX writes: flux (FVX,FVY,FVZ)</TD></TR>
        <TR><TD ALIGN="LEFT">WALL_BC writes: temp(bdy), wall, pbar, energy</TD></TR>
        </TABLE>
        >];
    }

    subgraph cluster_pipeline_corr {
        label="CORRECTOR Pipelining Opportunity (MAJOR)";
        style=dashed;
        color=red;
        fontsize=11;
        fontcolor=red;

        pipeline_corr [shape=plaintext, fontsize=9, label=<
        <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0">
        <TR><TD ALIGN="LEFT"><B>After MESH_EXCHANGE(4):</B></TD></TR>
        <TR><TD ALIGN="LEFT">Branch A: VELOCITY_FLUX (short, writes flux)</TD></TR>
        <TR><TD ALIGN="LEFT">Branch B: COMBUSTION → CONDENSATION → PART_MASS_ENERGY →</TD></TR>
        <TR><TD ALIGN="LEFT">  MOVE → PART_MOM → EX(7) → WALL_BC → EX(6) →</TD></TR>
        <TR><TD ALIGN="LEFT">  RADIATION → EX(2) → DIV_P1 (long chain, writes div, dsum)</TD></TR>
        <TR><TD ALIGN="LEFT">Join at: DIV_PART_2 (needs flux + div + DDDT)</TD></TR>
        <TR><TD ALIGN="LEFT"> </TD></TR>
        <TR><TD ALIGN="LEFT"><B>Key insight:</B> VELOCITY_FLUX completes quickly while</TD></TR>
        <TR><TD ALIGN="LEFT">the combustion/particle/wall/radiation chain takes much longer.</TD></TR>
        <TR><TD ALIGN="LEFT">This overlap is "free" — flux is ready before DIV_P2 needs it.</TD></TR>
        </TABLE>
        >];
    }

    // =====================================================================
    //  READ/WRITE SUMMARY TABLE
    // =====================================================================
    subgraph cluster_summary {
        label="Routine → Data Access Summary";
        style=dashed;
        color=gray;
        fontsize=12;

        summary [shape=plaintext, fontsize=8, label=<
        <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3">
        <TR><TD BGCOLOR="lightblue"><B>Routine</B></TD>
            <TD BGCOLOR="lightblue"><B>Reads</B></TD>
            <TD BGCOLOR="lightblue"><B>Writes</B></TD></TR>
        <TR><TD>COMPUTE_VISCOSITY</TD>
            <TD>vel/vel_s, rho/rho_s, species/species_s, temp</TD>
            <TD>visc (MU, KRES)</TD></TR>
        <TR><TD>MASS_FINITE_DIFF</TD>
            <TD>vel/vel_s, rho/rho_s, species/species_s, visc, temp</TD>
            <TD>diff (DEL_RHO_D_DEL_Z)</TD></TR>
        <TR><TD>DENSITY</TD>
            <TD>vel/vel_s, rho/rho_s, species/species_s, diff, wall, pbar</TD>
            <TD>rho_s/rho, species_s/species, temp</TD></TR>
        <TR><TD>VELOCITY_FLUX</TD>
            <TD>vel/vel_s, rho/rho_s, visc (MU), div/div_s, pres, edge</TD>
            <TD>flux (FVX,FVY,FVZ + baroclinic)</TD></TR>
        <TR><TD>WALL_BC</TD>
            <TD>vel, rho/rho_s, species/species_s, temp, wall</TD>
            <TD>temp(bdy), wall, pbar/pbar_s, energy (Q, M_DOT_PPP)</TD></TR>
        <TR><TD>PARTICLE_MOMENTUM</TD>
            <TD>part, vel/vel_s</TD>
            <TD>drag (FVX_D, FVY_D, FVZ_D)</TD></TR>
        <TR><TD>DIVERGENCE_PART_1</TD>
            <TD>vel/vel_s, rho/rho_s, species/species_s, temp, visc,<BR/>
                energy, qr, pbar/pbar_s, diff, wall</TD>
            <TD>div/div_s, dsum (D_SUM_LOC, P_SUM_LOC, U_SUM_LOC)</TD></TR>
        <TR><TD>DIVERGENCE_PART_2</TD>
            <TD>div/div_s, pbar/pbar_s, dsum, vel, vel_s, wall</TD>
            <TD>div/div_s (final), dddt, pbar/pbar_s (D_PBAR_DT)</TD></TR>
        <TR><TD>PRESSURE_SOLVE<BR/>(CHECK_RESIDUALS)</TD>
            <TD>flux, dddt, vel/vel_s, rho/rho_s, wall, visc (KRES)</TD>
            <TD>pres/pres_s (H/HS), pres_rhs (PRHS, BXS..BZF)</TD></TR>
        <TR><TD>VEL_PREDICTOR</TD>
            <TD>vel, pres (H), flux</TD>
            <TD>vel_s (US,VS,WS)</TD></TR>
        <TR><TD>VEL_CORRECTOR</TD>
            <TD>vel, vel_s, pres_s (HS), flux</TD>
            <TD>vel (U,V,W)</TD></TR>
        <TR><TD>COMBUSTION</TD>
            <TD>species, temp, rho</TD>
            <TD>species (ZZ), energy (Q, M_DOT_PPP)</TD></TR>
        <TR><TD>PART_MASS_ENERGY</TD>
            <TD>part, rho, species, temp</TD>
            <TD>energy (M_DOT_PPP, Q), part</TD></TR>
        <TR><TD>RADIATION</TD>
            <TD>temp, rho, species, wall</TD>
            <TD>qr (QR)</TD></TR>
        </TABLE>
        >];
    }
}
