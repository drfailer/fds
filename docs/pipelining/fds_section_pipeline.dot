// FDS Section-Level Pipeline Structure with Cost Annotations
//
// Reference scenario: 64^3 mesh, NS=5 species, typical fire simulation
// Costs in floating-point operations per mesh cell
//
// Color scheme:
//   Red/orange (#FF6347)  = Critical path (determines execution time)
//   Green (#90EE90)       = Hidden behind critical path ("free" overlap)
//   Gold (#FFD700)        = Fork/join synchronization points
//   Light salmon          = Mesh exchanges (network I/O)
//   Light blue (#d0d0ff)  = Pre-pipeline sequential
//   Light gray            = Negligible cost
//
// Implementation tiers:
//   Tier 1 = High impact, implement first
//   Tier 2 = Moderate impact, implement next
//   Tier 3 = Low impact, deferred

digraph FDS_Section_Pipeline {
    rankdir=TB;
    compound=true;
    fontname="Helvetica";
    node [fontname="Helvetica", fontsize=10, style=filled];
    edge [fontname="Helvetica", fontsize=8];
    newrank=true;
    splines=true;

    // =====================================================================
    //  PRE-PIPELINE (Sequential, already parallelized via mesh + K-block)
    //  Total: 1490 ops/cell per phase
    // =====================================================================
    subgraph cluster_pre_pred {
        label="Pre-Pipeline: Predictor\n1490 ops/cell (mesh+K-block parallel)";
        style=filled; fillcolor="#f0f0f0"; color=gray; fontsize=11;

        PP_INSERT [label="INSERT_PARTICLES\n~0 ops/cell", shape=box, fillcolor="#d0d0ff"];
        PP_VISC [label="COMPUTE_VISCOSITY\n90 ops/cell\n(strain: 73, MU: 5, KRES: 12)", shape=box, fillcolor="#d0d0ff"];
        PP_MFD [label="MASS_FINITE_DIFF\n400 ops/cell\n(NS x 80)", shape=box, fillcolor="#d0d0ff"];
        PP_DENS [label="DENSITY\n1000 ops/cell\n(NS x 180, flux limiter)", shape=box, fillcolor="#d0d0ff"];
        PP_EX1 [label="MESH_EXCHANGE(1)\nspecies_s, rho_s", shape=octagon, fillcolor=lightsalmon];

        PP_INSERT -> PP_VISC -> PP_MFD -> PP_DENS -> PP_EX1;
    }

    // =====================================================================
    //  PREDICTOR PIPELINE — Three-Way Fork (Tier 2)
    //  Sequential: 1739 ops/cell -> Pipelined: 1408 ops/cell (1.24x)
    // =====================================================================
    subgraph cluster_pred {
        label="PREDICTOR Pipeline  |  Sequential: 1739  ->  Pipelined: 1408 ops/cell  (1.24x)";
        style=filled; fillcolor="#e8f4fd"; color=steelblue; fontsize=12;

        PRED_FORK [label="THREE-WAY FORK\n(Tier 2)", shape=diamond, fillcolor="#FFD700", penwidth=2];

        // ---- Branch A: VELOCITY_FLUX + PART_MOM (green = hidden) ----
        subgraph cluster_pred_A {
            label="Branch A: 266 ops/cell\n(hidden behind C)";
            style=dashed; color="#228B22"; fontcolor="#228B22"; fontsize=10;
            labeljust=l;

            PA_VFLUX [label="VELOCITY_FLUX\n248 ops/cell\n(vort:44 + FVX/Y/Z:171 + baro:33)", shape=box, fillcolor="#90EE90"];
            PA_PMOM [label="PARTICLE_MOMENTUM\n18 ops/cell", shape=box, fillcolor="#90EE90"];
            PA_VFLUX -> PA_PMOM [label="FVX"];
        }

        // ---- Branch B: WALL_BC (green = hidden) ----
        subgraph cluster_pred_B {
            label="Branch B: 65 ops/cell\n(hidden behind C)";
            style=dashed; color="#228B22"; fontcolor="#228B22"; fontsize=10;
            labeljust=l;

            PB_WBC [label="WALL_BC\n65 ops/cell*\n(per wall cell: 210-1175)", shape=box, fillcolor="#90EE90"];
        }

        // ---- Branch C: DIV_P1 Interior (red = critical path) ----
        subgraph cluster_pred_C {
            label="Branch C: 1000 ops/cell\nCRITICAL PATH";
            style=dashed; color="#B22222"; fontcolor="#B22222"; fontsize=10;
            labeljust=l;

            PC_D1INT [label="DIV_P1 Interior\n1000 ops/cell\n(bulk I,J,K loops only)\n\nPh2A: species diffusion (130)\nPh3+4: thermal (95)\nPh5A: enthalpy adv. (105)\nPh5C: species flux lim. (670)\n[DOMINANT COST]", shape=box, fillcolor="#FF6347", penwidth=2];
        }

        // Fork edges
        PRED_FORK -> PA_VFLUX [color="#228B22", penwidth=2, label="A"];
        PRED_FORK -> PB_WBC [color="#228B22", penwidth=2, label="B"];
        PRED_FORK -> PC_D1INT [color="#B22222", penwidth=3, label="C (critical)"];

        // Join: DIV_P1 wall corrections need both B and C
        PRED_JOIN [label="JOIN", shape=diamond, fillcolor="#FFD700"];

        PC_D1INT -> PRED_JOIN [color="#B22222", penwidth=2, label="interior done"];
        PB_WBC -> PRED_JOIN [color="#228B22", label="B1 props"];

        // DIV_P1 wall corrections (critical path continues)
        PRED_D1WALL [label="DIV_P1 Wall Corrections\n300 ops/cell\n(boundary patches)", shape=box, fillcolor="#FF6347"];
        PRED_JOIN -> PRED_D1WALL [color="#B22222", penwidth=2];

        // Phase 6
        PRED_D1P6 [label="DIV_P1 Zone Sums\n15 ops/cell", shape=box, fillcolor="#FF6347"];
        PRED_D1WALL -> PRED_D1P6 [color="#B22222"];

        // Sequential tail
        PRED_DIVEX [label="DIV_EXCHANGE\n(global: DSUM/PSUM/USUM)", shape=octagon, fillcolor=lightsalmon];
        PRED_DIVP2 [label="DIV_P2\n40 ops/cell", shape=box, fillcolor="#FF6347"];
        PRED_PRES [label="PRESSURE_SOLVE\n50 ops/cell\n(BC:10 + RHS:10 + FFT:30)", shape=box, fillcolor="#FF6347"];
        PRED_VPRED [label="VEL_PREDICTOR\n18 ops/cell", shape=box, fillcolor="#FF6347"];
        PRED_CFL [label="CHECK_STABILITY\nCHANGE_TIME_STEP", shape=octagon, fillcolor=lightsalmon];
        PRED_EX3 [label="MESH_EXCHANGE(3)\nvel_s, pres", shape=octagon, fillcolor=lightsalmon];
        PRED_VBC [label="VEL_BC", shape=box, fillcolor="#d0d0ff"];

        PRED_D1P6 -> PRED_DIVEX [color="#B22222"];
        PA_PMOM -> PRED_PRES [color="#228B22", style=dashed, label="FVX+drag\n(ready at t=266)"];
        PRED_DIVEX -> PRED_DIVP2 -> PRED_PRES -> PRED_VPRED [color="#B22222", penwidth=2];
        PRED_VPRED -> PRED_CFL -> PRED_EX3 -> PRED_VBC;
    }

    PP_EX1 -> PRED_FORK;

    // =====================================================================
    //  PRE-PIPELINE: Corrector
    // =====================================================================
    subgraph cluster_pre_corr {
        label="Pre-Pipeline: Corrector\n1490 ops/cell";
        style=filled; fillcolor="#f0f0f0"; color=gray; fontsize=11;

        CP_VISC [label="COMPUTE_VISCOSITY\n90 ops/cell", shape=box, fillcolor="#d0d0ff"];
        CP_MFD [label="MASS_FINITE_DIFF\n400 ops/cell", shape=box, fillcolor="#d0d0ff"];
        CP_DENS [label="DENSITY\n1000 ops/cell", shape=box, fillcolor="#d0d0ff"];
        CP_EX4 [label="MESH_EXCHANGE(4)\nspecies, rho", shape=octagon, fillcolor=lightsalmon];

        CP_VISC -> CP_MFD -> CP_DENS -> CP_EX4;
    }

    PRED_VBC -> CP_VISC [style=bold, color=blue, label="phase transition"];

    // =====================================================================
    //  CORRECTOR PIPELINE — Two Fork-Join Pairs (Tier 1 + Tier 1)
    //  Sequential: 5364 ops/cell -> Pipelined: 3940 ops/cell (1.36x)
    // =====================================================================
    subgraph cluster_corr {
        label="CORRECTOR Pipeline  |  Sequential: 5364  ->  Pipelined: 3940 ops/cell  (1.36x)";
        style=filled; fillcolor="#fdf8e8"; color=darkgoldenrod; fontsize=12;

        // =========== Fork 1: VFLUX || COMBUSTION chain (Tier 1.1) ===========
        CORR_FORK1 [label="FORK 1\n(Tier 1)", shape=diamond, fillcolor="#FFD700", penwidth=2];

        // Branch A: VFLUX (critical — dominates short Branch B)
        subgraph cluster_corr_A {
            label="Branch A: 248 ops/cell\nCRITICAL PATH";
            style=dashed; color="#B22222"; fontcolor="#B22222"; fontsize=10;

            CA_VFLUX [label="VELOCITY_FLUX\n248 ops/cell", shape=box, fillcolor="#FF6347"];
        }

        // Branch B: COMBUSTION chain (green = hidden behind A)
        subgraph cluster_corr_B {
            label="Branch B: 125 ops/cell\n(hidden behind A)";
            style=dashed; color="#228B22"; fontcolor="#228B22"; fontsize=10;

            CB_COMB [label="COMBUSTION\n115 ops/cell\n(10% active x 1150)", shape=box, fillcolor="#90EE90"];
            CB_COND [label="CONDENSATION\n10 ops/cell\n(1% active x 450)", shape=box, fillcolor="#90EE90"];
            CB_PME [label="PART_MASS_ENERGY\n(particle-dependent)", shape=box, fillcolor="#90EE90"];
            CB_MOVE [label="MOVE_PARTICLES\n(particle-dependent)", shape=box, fillcolor="#90EE90"];
            CB_COMB -> CB_COND -> CB_PME -> CB_MOVE;
        }

        CORR_FORK1 -> CA_VFLUX [color="#B22222", penwidth=3, label="A (critical)"];
        CORR_FORK1 -> CB_COMB [color="#228B22", penwidth=2, label="B (hidden)"];

        // Join 1
        CORR_JOIN1 [label="JOIN 1", shape=diamond, fillcolor="#FFD700"];
        CA_VFLUX -> CORR_JOIN1 [color="#B22222", penwidth=2, label="FVX"];
        CB_MOVE -> CORR_JOIN1 [color="#228B22", label="FVX_D, particles"];

        // Sequential between forks
        CORR_PMOM [label="PARTICLE_MOMENTUM\n18 ops/cell", shape=box, fillcolor="#FF6347"];
        CORR_EX7 [label="MESH_EXCHANGE(7)\nparticles", shape=octagon, fillcolor=lightsalmon];
        CORR_WBC [label="WALL_BC\n65 ops/cell", shape=box, fillcolor="#FF6347"];
        CORR_EX6a [label="MESH_EXCHANGE(6)\nwall / 3D HT", shape=octagon, fillcolor=lightsalmon];

        CORR_JOIN1 -> CORR_PMOM [color="#B22222", penwidth=2];
        CORR_PMOM -> CORR_EX7 -> CORR_WBC -> CORR_EX6a;

        // =========== Fork 2: RADIATION || DIV_P1 main (Tier 1.2) ===========
        CORR_FORK2 [label="FORK 2\n(Tier 1)", shape=diamond, fillcolor="#FFD700", penwidth=2];
        CORR_EX6a -> CORR_FORK2;

        // Branch C: RADIATION (critical — usually dominates)
        subgraph cluster_corr_C {
            label="Branch C: 3500 ops/cell\nCRITICAL PATH (typical fire)";
            style=dashed; color="#B22222"; fontcolor="#B22222"; fontsize=10;

            CC_RADI [label="RADIATION\n3500 ops/cell\n(range: 500 - 15000)\n\nDOMINANT COST\nwhen active", shape=box, fillcolor="#FF6347", penwidth=3];
        }

        // Branch D: DIV_P1 main (green = hidden behind RADIATION)
        subgraph cluster_corr_D {
            label="Branch D: 1299 ops/cell\n(hidden behind C when radiation active)";
            style=dashed; color="#228B22"; fontcolor="#228B22"; fontsize=10;

            CD_D1MAIN [label="DIV_P1 (excl. QR)\n1299 ops/cell\n\nPh2: species+heat diff (200)\nPh3+4: thermal (95)\nPh5A: enthalpy adv. (105)\nPh5B: RTRM (5)\nPh5C+D: species adv. (770)\nPh5E-G: sources (10)\nPh6: zone sums (15)\n[wall corr. included]", shape=box, fillcolor="#90EE90"];
        }

        CORR_FORK2 -> CC_RADI [color="#B22222", penwidth=3, label="C (critical)"];
        CORR_FORK2 -> CD_D1MAIN [color="#228B22", penwidth=2, label="D (hidden)"];

        // Join 2: QR exchange then QR addition
        CORR_EX2 [label="MESH_EXCHANGE(2)\nQR exchange", shape=octagon, fillcolor=lightsalmon];
        CC_RADI -> CORR_EX2 [color="#B22222", penwidth=2, label="QR"];

        CORR_JOIN2 [label="JOIN 2", shape=diamond, fillcolor="#FFD700"];
        CORR_EX2 -> CORR_JOIN2 [color="#B22222", label="QR exchanged"];
        CD_D1MAIN -> CORR_JOIN2 [color="#228B22", label="DP computed\n(without QR)"];

        // QR addition (trivial)
        CORR_QRADD [label="DIV_P1: QR Addition\n1 op/cell\n(DP += QR, single line)", shape=box, fillcolor=lightgray];
        CORR_JOIN2 -> CORR_QRADD;

        // Sequential tail
        CORR_DIVEX [label="DIV_EXCHANGE\n(DSUM/PSUM/USUM)", shape=octagon, fillcolor=lightsalmon];
        CORR_DIVP2 [label="DIV_P2\n40 ops/cell", shape=box, fillcolor="#FF6347"];
        CORR_PRES [label="PRESSURE_SOLVE\n50 ops/cell", shape=box, fillcolor="#FF6347"];
        CORR_VCORR [label="VEL_CORRECTOR\n18 ops/cell", shape=box, fillcolor="#FF6347"];
        CORR_EX6b [label="MESH_EXCHANGE(6)\nvel, pres_s", shape=octagon, fillcolor=lightsalmon];
        CORR_VBC [label="VEL_BC", shape=box, fillcolor="#d0d0ff"];
        CORR_DUMP [label="DUMP\n(output)", shape=box, fillcolor=lightgray];

        CA_VFLUX -> CORR_PRES [color="#228B22", style=dashed, label="FVX\n(ready at t=248)"];
        CORR_QRADD -> CORR_DIVEX;
        CORR_DIVEX -> CORR_DIVP2 -> CORR_PRES -> CORR_VCORR [color="#B22222", penwidth=2];
        CORR_VCORR -> CORR_EX6b -> CORR_VBC -> CORR_DUMP;
    }

    CP_EX4 -> CORR_FORK1;

    // Timestep cycle
    CORR_DUMP -> PP_INSERT [style=bold, color=blue, label="next timestep"];

    // =====================================================================
    //  SUMMARY TABLE
    // =====================================================================
    subgraph cluster_summary {
        label="Pipeline Speedup Summary";
        style=dashed; color=gray; fontsize=12;

        summary [shape=plaintext, fontsize=9, label=<
        <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4">
        <TR><TD COLSPAN="5" BGCOLOR="lightyellow"><B>Speedup Analysis (64^3 mesh, NS=5, radiation=3500 ops/cell)</B></TD></TR>
        <TR><TD><B>Phase</B></TD><TD><B>Sequential</B></TD><TD><B>Pipelined</B></TD><TD><B>Saved</B></TD><TD><B>Speedup</B></TD></TR>
        <TR><TD>Predictor pipeline</TD><TD>1739 ops/cell</TD><TD>1408 ops/cell</TD><TD>331</TD><TD BGCOLOR="#90EE90"><B>1.24x</B></TD></TR>
        <TR><TD>Corrector pipeline</TD><TD>5364 ops/cell</TD><TD>3940 ops/cell</TD><TD>1424</TD><TD BGCOLOR="#90EE90"><B>1.36x</B></TD></TR>
        <TR><TD><B>Combined pipeline</B></TD><TD><B>7103</B></TD><TD><B>5348</B></TD><TD><B>1755</B></TD><TD BGCOLOR="#90EE90"><B>1.33x</B></TD></TR>
        <TR><TD>Full timestep (incl. pre-pipeline)</TD><TD>10083</TD><TD>8328</TD><TD>1755</TD><TD BGCOLOR="#90EE90"><B>1.21x</B></TD></TR>
        <TR><TD COLSPAN="5" BGCOLOR="lightyellow"><B>Implementation Priority</B></TD></TR>
        <TR><TD><B>Tier</B></TD><TD COLSPAN="2"><B>Change</B></TD><TD><B>Savings</B></TD><TD><B>Complexity</B></TD></TR>
        <TR><TD BGCOLOR="#90EE90">Tier 1.1</TD><TD COLSPAN="2">Corrector: VFLUX || COMB chain</TD><TD>125 ops/cell</TD><TD>Low</TD></TR>
        <TR><TD BGCOLOR="#90EE90">Tier 1.2</TD><TD COLSPAN="2">Corrector: RADIATION || DIV_P1</TD><TD>1299 ops/cell</TD><TD>Medium</TD></TR>
        <TR><TD BGCOLOR="lightyellow">Tier 2</TD><TD COLSPAN="2">Predictor: 3-way fork (VFLUX || WBC || DIV_P1_int)</TD><TD>331 ops/cell</TD><TD>Medium</TD></TR>
        <TR><TD BGCOLOR="lightgray">Tier 3</TD><TD COLSPAN="2">Pressure BC || DIV_P2, intra-DIV_P1 A||B||C</TD><TD>&lt;200</TD><TD>High</TD></TR>
        </TABLE>
        >];
    }

    // =====================================================================
    //  COST BREAKDOWN REFERENCE
    // =====================================================================
    subgraph cluster_costs {
        label="Section Cost Reference (ops/cell, NS=5)";
        style=dashed; color=gray; fontsize=12;

        costs [shape=plaintext, fontsize=8, label=<
        <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3">
        <TR><TD BGCOLOR="lightblue"><B>Section</B></TD>
            <TD BGCOLOR="lightblue"><B>Ops/cell</B></TD>
            <TD BGCOLOR="lightblue"><B>Scaling</B></TD>
            <TD BGCOLOR="lightblue"><B>Bottleneck</B></TD></TR>
        <TR><TD>COMPUTE_VISCOSITY</TD><TD>90</TD><TD>~const</TD><TD>Strain rate (9 vel diffs, 6 squares)</TD></TR>
        <TR><TD>MASS_FINITE_DIFF</TD><TD>400</TD><TD>NS x 80</TD><TD>GET_SCALAR_FACE_VALUE</TD></TR>
        <TR><TD>DENSITY</TD><TD>1000</TD><TD>NS x 180</TD><TD>Species flux limiter + density sum</TD></TR>
        <TR><TD>VELOCITY_FLUX</TD><TD>248</TD><TD>~const</TD><TD>FVX/FVY/FVZ (57 each)</TD></TR>
        <TR><TD>WALL_BC</TD><TD>65*</TD><TD>per wall cell</TD><TD>SOLID_HEAT_TRANSFER (1D conduction)</TD></TR>
        <TR><TD>PARTICLE_MOMENTUM</TD><TD>18</TD><TD>~const</TD><TD>Drag interpolation</TD></TR>
        <TR><TD>DIV_P1 total</TD><TD>1300</TD><TD>NS x 200</TD><TD>Ph5C: GET_SCALAR_FACE_VALUE (670)</TD></TR>
        <TR><TD>  Ph2A+2B: diffusion</TD><TD>200</TD><TD>NS x 40</TD><TD>Species gradients on faces</TD></TR>
        <TR><TD>  Ph3+4: thermal</TD><TD>95</TD><TD>~const</TD><TD>CP mixture + KP divergence</TD></TR>
        <TR><TD>  Ph5A: enthalpy adv.</TD><TD>105</TD><TD>NS x 20</TD><TD>Enthalpy face interpolation</TD></TR>
        <TR><TD>  Ph5C+D: species adv.</TD><TD>770</TD><TD>NS x 150</TD><TD>Flux limiter (40-60 ops/face)</TD></TR>
        <TR><TD>DIV_P2</TD><TD>40</TD><TD>~const</TD><TD>DDDT + D_PBAR_DT</TD></TR>
        <TR><TD>PRESSURE_SOLVE</TD><TD>50</TD><TD>N log N</TD><TD>FFT solve (30 ops/cell)</TD></TR>
        <TR><TD>VEL_PREDICTOR/CORR</TD><TD>18</TD><TD>~const</TD><TD>US = U - DT*(FVX + dH/dx)</TD></TR>
        <TR><TD>COMBUSTION</TD><TD>115</TD><TD>% active</TD><TD>Chemistry ODE (1150 x 10% active)</TD></TR>
        <TR><TD>CONDENSATION</TD><TD>10</TD><TD>% active</TD><TD>Phase change (450 x 2% active)</TD></TR>
        <TR><TD BGCOLOR="mistyrose"><B>RADIATION</B></TD><TD BGCOLOR="mistyrose"><B>3500</B></TD><TD BGCOLOR="mistyrose"><B>N_angles</B></TD><TD BGCOLOR="mistyrose"><B>Angle sweep (500-15000 range)</B></TD></TR>
        </TABLE>
        >];
    }
}
