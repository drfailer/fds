// FDS Pipelining Opportunities — Refined with Verified Data Dependencies
//
// KEY INSIGHT: VELOCITY_FLUX and WALL_BC have NO data conflicts.
// PARTICLE_MOMENTUM writes to FVX (adds drag) so depends on VELOCITY_FLUX.
// DIV_PART_1 does NOT read FVX/FVY/FVZ (those are used later in PRESSURE_SOLVE).
// This enables TWO levels of pipelining.

digraph FDS_Pipeline {
    rankdir=TB;
    compound=true;
    fontname="Helvetica";
    node [fontname="Helvetica", fontsize=11, style=filled];
    edge [fontname="Helvetica", fontsize=9];

    // =====================================================================
    //  PREDICTOR PIPELINING (2 levels)
    // =====================================================================
    subgraph cluster_pred {
        label="PREDICTOR — Two-Level Pipelining";
        style=filled; fillcolor="#f0f8ff"; color=steelblue; fontsize=13;

        P_EX1 [label="MESH_EXCHANGE(1)\n+ HVAC + InitDiv", shape=octagon, fillcolor=lightsalmon];

        // Level 1: two independent branches
        P_VFLUX [label="VELOCITY_FLUX\n\nReads: vel, rho, visc, div, edge\nWrites: flux (FVX,FVY,FVZ)", shape=box, fillcolor="#90EE90"];
        P_WALLBC [label="WALL_BC\n\nReads: vel, rho_s, species_s, temp, wall\nWrites: temp(bdy), wall, pbar, energy", shape=box, fillcolor="#87CEEB"];

        // Level 2: two independent branches after Level 1
        P_PARTMOM [label="PARTICLE_MOMENTUM\n\nReads: FVX_D (pre-existing), FVX (from VFLUX)\nWrites: FVX += drag", shape=box, fillcolor="#90EE90"];
        P_DIVP1 [label="DIVERGENCE_PART_1\n\nReads: rho_s, species_s, temp, visc,\n       energy, qr, pbar, diff, wall\nWrites: div_s (DS), dsum\n\nDoes NOT read FVX/FVY/FVZ", shape=box, fillcolor="#87CEEB"];

        P_DIVEX [label="DIV_EXCHANGE", shape=diamond, fillcolor=lightsalmon];

        // Join point
        P_DIVP2 [label="DIVERGENCE_PART_2\n\nReads: div_s, pbar, dsum, vel\nWrites: DDDT, div_s(final)", shape=box, fillcolor="#FFD700"];
        P_PRES [label="PRESSURE_SOLVE\n\nReads: FVX/FVY/FVZ (for PRHS),\n       DDDT (from DIV_P2)\nWrites: H (pressure)", shape=box, fillcolor="#FFD700"];
        P_VELPRED [label="VEL_PREDICTOR\n\nUS = U - DT*(FVX + dH/dx)\nReads: flux, pres", shape=box, fillcolor=plum];

        // Level 1 edges
        P_EX1 -> P_VFLUX [color=red, penwidth=2, label="Level 1\nBranch A"];
        P_EX1 -> P_WALLBC [color=blue, penwidth=2, label="Level 1\nBranch B"];

        // Level 2 edges (after Level 1 join)
        P_VFLUX -> P_PARTMOM [label="FVX written\n(drag will be added)", color=red, penwidth=2];
        P_WALLBC -> P_DIVP1 [label="energy, pbar", color=blue, penwidth=2];

        // Level 2 branches are independent of each other
        P_PARTMOM -> P_PRES [label="FVX\n(with drag)", color=red, style=dashed];
        P_DIVP1 -> P_DIVEX [color=blue];
        P_DIVEX -> P_DIVP2 [color=blue];

        // Join at PRESSURE_SOLVE
        P_DIVP2 -> P_PRES [label="DDDT", color=blue, penwidth=2];
        P_PRES -> P_VELPRED [label="H, FVX"];

        // Rank hints for layout
        {rank=same; P_VFLUX; P_WALLBC}
        {rank=same; P_PARTMOM; P_DIVP1}
    }

    // =====================================================================
    //  CORRECTOR PIPELINING (MAJOR OPPORTUNITY)
    // =====================================================================
    subgraph cluster_corr {
        label="CORRECTOR — Pipeline After MESH_EXCHANGE(4)";
        style=filled; fillcolor="#fffff0"; color=darkgoldenrod; fontsize=13;

        C_EX4 [label="MESH_EXCHANGE(4)", shape=octagon, fillcolor=lightsalmon];

        // Branch A: short
        C_VFLUX [label="VELOCITY_FLUX\n(short, fast)\n\nWrites: FVX,FVY,FVZ", shape=box, fillcolor="#90EE90"];

        // Branch B: long chain (until PART_MOM needs VFLUX output)
        C_COMB [label="COMBUSTION\nWrites: species, energy", shape=box, fillcolor="#ADD8E6"];
        C_COND [label="CONDENSATION", shape=box, fillcolor="#ADD8E6"];
        C_PME [label="PART_MASS_ENERGY\nWrites: energy(M_DOT_PPP), part", shape=box, fillcolor="#ADD8E6"];
        C_MOVE [label="MOVE_PARTICLES\nWrites: part positions, FVX_D", shape=diamond, fillcolor=lightsalmon];

        // Join point: PART_MOM needs both VFLUX and MOVE outputs
        C_PM [label="PARTICLE_MOMENTUM\n\nReads: FVX (from VFLUX) + FVX_D (from MOVE)\nWrites: FVX += drag", shape=box, fillcolor="#FFD700"];

        // Continues sequentially after join
        C_EX7 [label="MESH_EXCHANGE(7)", shape=octagon, fillcolor=lightsalmon];
        C_WBC [label="WALL_BC\nWrites: temp(bdy), pbar, energy", shape=box, fillcolor="#ADD8E6"];
        C_EX6 [label="MESH_EXCHANGE(6)", shape=octagon, fillcolor=lightsalmon];
        C_RADI [label="RADIATION\nWrites: QR", shape=box, fillcolor="#ADD8E6"];
        C_EX2 [label="EX(2) + InitDiv", shape=octagon, fillcolor=lightsalmon];
        C_DIVP1 [label="DIV_PART_1\nWrites: div, dsum", shape=box, fillcolor="#ADD8E6"];
        C_DIVEX [label="DIV_EXCHANGE", shape=diamond, fillcolor=lightsalmon];
        C_DIVP2 [label="DIV_PART_2\nWrites: DDDT", shape=box, fillcolor="#ADD8E6"];

        // Final join: PRESSURE_SOLVE needs both FVX and DDDT
        C_PRES [label="PRESSURE_SOLVE\nReads: FVX, DDDT\nWrites: HS", shape=box, fillcolor="#FFD700"];
        C_VELCORR [label="VEL_CORRECTOR\nU = 0.5*(U+US-DT*(FVX+dHS/dx))", shape=box, fillcolor=plum];

        // Branch A
        C_EX4 -> C_VFLUX [color=red, penwidth=2, label="Branch A (SHORT)"];

        // Branch B
        C_EX4 -> C_COMB [color=blue, penwidth=2, label="Branch B (LONG)"];
        C_COMB -> C_COND [color=blue];
        C_COND -> C_PME [color=blue];
        C_PME -> C_MOVE [color=blue];

        // JOIN at PART_MOM (needs both branches)
        C_MOVE -> C_PM [label="FVX_D, part", color=blue, penwidth=2];
        C_VFLUX -> C_PM [label="FVX\n(completed)", color=red, penwidth=2, style=bold];

        // Continue sequential
        C_PM -> C_EX7 [color=purple];
        C_EX7 -> C_WBC [color=purple];
        C_WBC -> C_EX6 [color=purple];
        C_EX6 -> C_RADI [color=purple];
        C_RADI -> C_EX2 [color=purple];
        C_EX2 -> C_DIVP1 [color=purple];
        C_DIVP1 -> C_DIVEX [color=purple];
        C_DIVEX -> C_DIVP2 [color=purple];
        C_DIVP2 -> C_PRES [label="DDDT", color=purple, penwidth=2];
        C_PRES -> C_VELCORR [label="HS, FVX"];

        {rank=same; C_VFLUX; C_COMB}
    }

    // =====================================================================
    //  DEPENDENCY PROOF TABLE
    // =====================================================================
    subgraph cluster_proof {
        label="Data Dependency Proof";
        style=dashed; color=gray; fontsize=12;

        proof [shape=plaintext, fontsize=9, label=<
        <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4">
        <TR><TD COLSPAN="4" BGCOLOR="lightyellow"><B>Level 1: VELOCITY_FLUX ∥ WALL_BC (no conflicts)</B></TD></TR>
        <TR><TD><B>Array</B></TD><TD><B>VELOCITY_FLUX</B></TD><TD><B>WALL_BC</B></TD><TD><B>Conflict?</B></TD></TR>
        <TR><TD>vel (U,V,W)</TD><TD>Read</TD><TD>Read</TD><TD BGCOLOR="#90EE90">None (R∥R)</TD></TR>
        <TR><TD>rho/rho_s</TD><TD>Read</TD><TD>Read</TD><TD BGCOLOR="#90EE90">None (R∥R)</TD></TR>
        <TR><TD>visc (MU)</TD><TD>Read</TD><TD>Read</TD><TD BGCOLOR="#90EE90">None (R∥R)</TD></TR>
        <TR><TD>flux (FVX,FVY,FVZ)</TD><TD BGCOLOR="#90EE90"><B>Write</B></TD><TD>—</TD><TD BGCOLOR="#90EE90">None</TD></TR>
        <TR><TD>species/species_s</TD><TD>—</TD><TD>Read</TD><TD BGCOLOR="#90EE90">None</TD></TR>
        <TR><TD>temp (TMP)</TD><TD>—</TD><TD>Read/Write(bdy)</TD><TD BGCOLOR="#90EE90">None</TD></TR>
        <TR><TD>energy (Q, M_DOT_PPP)</TD><TD>—</TD><TD BGCOLOR="#ADD8E6"><B>Write</B></TD><TD BGCOLOR="#90EE90">None</TD></TR>
        <TR><TD>pbar (D_PBAR_DT_S)</TD><TD>—</TD><TD BGCOLOR="#ADD8E6"><B>Write</B></TD><TD BGCOLOR="#90EE90">None</TD></TR>
        <TR><TD COLSPAN="4" BGCOLOR="lightyellow"><B>Level 2: PARTICLE_MOM ∥ DIV_P1 (no conflicts)</B></TD></TR>
        <TR><TD>flux (FVX,FVY,FVZ)</TD><TD COLSPAN="2">PART_MOM: Read+Write (adds drag)</TD><TD BGCOLOR="#90EE90">DIV_P1 does NOT read FVX</TD></TR>
        <TR><TD>energy, pbar</TD><TD COLSPAN="2">DIV_P1: Read (from WALL_BC)</TD><TD BGCOLOR="#90EE90">PART_MOM does NOT touch these</TD></TR>
        <TR><TD>div_s, dsum</TD><TD COLSPAN="2">DIV_P1: Write</TD><TD BGCOLOR="#90EE90">PART_MOM does NOT touch these</TD></TR>
        <TR><TD COLSPAN="4" BGCOLOR="lightyellow"><B>Corrector: VELOCITY_FLUX ∥ (COMBUSTION→...→MOVE)</B></TD></TR>
        <TR><TD>flux (FVX)</TD><TD COLSPAN="2">VFLUX writes; COMB/PME/MOVE don't touch</TD><TD BGCOLOR="#90EE90">No conflict until PART_MOM</TD></TR>
        <TR><TD>species (ZZ)</TD><TD COLSPAN="2">VFLUX doesn't touch; COMB writes</TD><TD BGCOLOR="#90EE90">No conflict</TD></TR>
        </TABLE>
        >];
    }
}
