// FDS Thread Safety Map
// Render: dot -Tsvg thread_safety.dot -o thread_safety.svg
//
// Shows thread safety status of all per-mesh computation routines.
// Green  = thread-safe (kernel extracted, explicit MESH_TYPE arg)
// Yellow = partially safe (kernel exists but orchestration uses POINT_TO_MESH)
// Red    = not thread-safe (POINT_TO_MESH, SAVE vars, global state)
// Gray   = not per-mesh (global or rank-0 only)

digraph thread_safety {
    rankdir=TB;
    fontname="Helvetica";
    node [fontname="Helvetica", fontsize=9, shape=box, style="filled,rounded"];
    edge [fontsize=8, color="#888888"];
    label="FDS Thread Safety Assessment\nfor Per-Mesh Parallel Execution";
    labelloc=t;
    fontsize=14;

    // =========================================================================
    // Legend
    // =========================================================================
    subgraph cluster_legend {
        label="Legend";
        style=filled; fillcolor="#f8f8f8";
        rank=same;
        l1 [label="Kernel: thread-safe\n(explicit MESH_TYPE arg)", fillcolor="#b3e2cd"];
        l2 [label="Orchestration: unsafe\n(uses POINT_TO_MESH)", fillcolor="#fff2ae"];
        l3 [label="Not thread-safe\n(SAVE vars, global state)", fillcolor="#fbb4ae"];
        l4 [label="Global operation\n(not per-mesh)", fillcolor="#d9d9d9"];
        l5 [label="Blocker: critical\nthread-safety issue", fillcolor="#ff8888", shape=octagon];
        l1 -> l2 -> l3 -> l4 -> l5 [style=invis];
    }

    // =========================================================================
    // Blockers (critical issues)
    // =========================================================================
    subgraph cluster_blockers {
        label="Critical Thread-Safety Blockers";
        style=filled; fillcolor="#ffe0e0";

        blocker_ptm [label="POINT_TO_MESH\n(mesh.f90)\n~200 module-level pointer aliases\nThread A and B corrupt each other\n14 modules still use this", fillcolor="#ff8888", shape=octagon];

        blocker_qdot [label="Q_DOT, M_DOT\n(data.f90)\nGlobal accumulators\nwritten by DIVERGENCE_PART_1\nacross all meshes", fillcolor="#ff8888", shape=octagon];

        blocker_tused [label="T_USED(:)\n(cons.f90)\nTiming accumulator\nincremented by every routine", fillcolor="#ff8888", shape=octagon];

        blocker_save_pres [label="CYL_FCT, ILO/IHI_CELL/FACE\n(pres.f90)\nSAVE variables written\nper-mesh during solve", fillcolor="#ff8888", shape=octagon];

        blocker_save_geom [label="32 SAVE variables\n(geom.f90)\nCC_NEDGECROSS, T_CC_USED,\nILO/IHI_CELL/FACE, ...\nWritten during CC_IBM processing", fillcolor="#ff8888", shape=octagon];

        blocker_save_ccdata [label="ILO/IHI, NXB/NYB/NZB\n(ccib_data.f90)\nSAVE loop bounds\nwritten per-mesh", fillcolor="#ff8888", shape=octagon];
    }

    // =========================================================================
    // Numerical solver routines
    // =========================================================================
    subgraph cluster_solvers {
        label="Numerical Solvers";
        style=filled; fillcolor="#f0f0f0";

        // MASS module
        mass_orch [label="DENSITY\nMASS_FINITE_DIFFERENCES_NEW\n(mass.f90 orchestration)\nuses POINT_TO_MESH", fillcolor="#fff2ae"];
        mass_kern [label="DENSITY_KERNEL\nMASS_FD_KERNEL\n(mass_kernels.f90)\nThread-safe", fillcolor="#b3e2cd"];
        mass_orch -> mass_kern [label="calls"];

        // VELO module
        velo_orch [label="VELOCITY_FLUX\nVELOCITY_PREDICTOR\nVELOCITY_CORRECTOR\nVISCOSITY_BC / VELOCITY_BC\n(velo.f90 orchestration)\nuses POINT_TO_MESH", fillcolor="#fff2ae"];
        velo_kern [label="VELOCITY_FLUX_KERNEL\nVELOCITY_PREDICTOR_KERNEL\nVELOCITY_CORRECTOR_KERNEL\n(velo_kernels.f90)\nThread-safe", fillcolor="#b3e2cd"];
        velo_orch -> velo_kern [label="calls"];

        // DIVG module
        divg_orch [label="DIVERGENCE_PART_1\nDIVERGENCE_PART_2\n(divg.f90 orchestration)\nuses POINT_TO_MESH\n+ writes Q_DOT, M_DOT", fillcolor="#fbb4ae"];
        divg_kern [label="DIVERGENCE_PART_1_KERNEL\nDIVERGENCE_PART_2_KERNEL\n(divg_kernels.f90)\nThread-safe", fillcolor="#b3e2cd"];
        divg_orch -> divg_kern [label="calls"];
        divg_orch -> blocker_qdot [label="writes", color=red, style=dashed];

        // PRES module
        pres_orch [label="PRESSURE_SOLVER_FFT\nPRESSURE_SOLVER_COMPUTE_RHS\nNO_FLUX\nCOMPUTE_VELOCITY_ERROR\n(pres.f90 orchestration)\nuses POINT_TO_MESH\n+ CYL_FCT SAVE", fillcolor="#fbb4ae"];
        pres_kern [label="PRESSURE_SOLVER_COMPUTE_RHS_K\nPRESSURE_SOLVER_FFT_K\n(pres_kernels.f90)\nThread-safe", fillcolor="#b3e2cd"];
        pres_orch -> pres_kern [label="calls"];
        pres_orch -> blocker_save_pres [label="writes", color=red, style=dashed];

        // POIS module
        pois [label="POIS module\n(pois.f90)\nPOIS_WORK type (SAVE)\nFixed: thread-local POIS_WORK", fillcolor="#b3e2cd"];
    }

    // =========================================================================
    // Physics routines
    // =========================================================================
    subgraph cluster_physics {
        label="Physics Routines";
        style=filled; fillcolor="#f0f0f0";

        // FIRE module
        fire_orch [label="COMBUSTION_LOAD_BALANCED\n(fire.f90)\nGlobal load distribution\nSAVE: T_CHEM_ODE,\nCOMBUSTION_INIT", fillcolor="#d9d9d9"];
        fire_kern [label="FIRE_KERNELS\n(fire_kernels.f90)\nThread-safe\n(except DZ_F0 SAVE)", fillcolor="#b3e2cd"];
        fire_orch -> fire_kern [label="calls"];

        // TURB module
        turb_orch [label="COMPUTE_VISCOSITY\n(turb.f90 orchestration)\nuses POINT_TO_MESH", fillcolor="#fff2ae"];
        turb_kern [label="WALE_VISCOSITY\nWALL_MODEL\nTEST_FILTER\n(turb_kernels.f90)\nThread-safe", fillcolor="#b3e2cd"];
        turb_orch -> turb_kern [label="calls"];

        // WALL module
        wall_orch [label="WALL_BC\n(wall.f90 orchestration)\nuses POINT_TO_MESH\n+ module-level pointers\n(PBAR_P, RHOP, UU, VV, WW)", fillcolor="#fbb4ae"];
        wall_kern [label="CALCULATE_RHO_D_F\nCALC_DEPOSITION\nPYROLYSIS\n(wall_kernels.f90)\nThread-safe", fillcolor="#b3e2cd"];
        wall_orch -> wall_kern [label="calls"];

        // RAD module
        rad [label="COMPUTE_RADIATION\n(radi.f90)\nFull POINT_TO_MESH usage\nMultiple SAVE arrays\nNot kernel-extracted", fillcolor="#fbb4ae"];

        // PART module
        part [label="INSERT_ALL_PARTICLES\nMOVE_PARTICLES\nPARTICLE_MASS_ENERGY_TRANSFER\n(part.f90)\nFull POINT_TO_MESH usage\nNot kernel-extracted", fillcolor="#fbb4ae"];

        // HVAC
        hvac [label="HVAC_CALC\n(hvac.f90)\nRank 0 only\nSAVE solver state", fillcolor="#d9d9d9"];

        // SOOT
        soot [label="CALC_AGGLOMERATION\n(soot.f90)\nPOINT_TO_MESH\nSAVE arrays", fillcolor="#fbb4ae"];

        // VEGE
        vege [label="LEVEL_SET_FIRESPREAD\n(vege.f90)\nPOINT_TO_MESH\nSAVE pointers", fillcolor="#fbb4ae"];
    }

    // =========================================================================
    // CC_IBM routines
    // =========================================================================
    subgraph cluster_ccibm {
        label="Complex Geometry (CC_IBM)";
        style=filled; fillcolor="#f0f0f0";

        cc_div_orch [label="CC_DIVERGENCE\n(orchestration)\nPOINT_TO_MESH", fillcolor="#fff2ae"];
        cc_div_kern [label="CC_DIVERGENCE_KERNELS\nThread-safe", fillcolor="#b3e2cd"];
        cc_div_orch -> cc_div_kern [label="calls"];

        cc_vel_orch [label="CC_VELOCITY\n(orchestration)\nPOINT_TO_MESH", fillcolor="#fff2ae"];
        cc_vel_kern [label="CC_VELOCITY_KERNELS\nThread-safe", fillcolor="#b3e2cd"];
        cc_vel_orch -> cc_vel_kern [label="calls"];

        cc_pres_orch [label="CC_PRESSURE\n(orchestration)\nPOINT_TO_MESH", fillcolor="#fff2ae"];
        cc_pres_kern [label="CC_PRESSURE_KERNELS\nThread-safe", fillcolor="#b3e2cd"];
        cc_pres_orch -> cc_pres_kern [label="calls"];

        cc_density [label="CC_DENSITY_MOD\n(orchestration)\n100% orchestration", fillcolor="#fff2ae"];
        cc_geom [label="COMPLEX_GEOMETRY\n(geom.f90)\n32 SAVE variables\nCritical blocker", fillcolor="#fbb4ae"];
        cc_geom -> blocker_save_geom [label="contains", color=red, style=dashed];

        cc_data [label="CC_SCALARS_DATA\n(ccib_data.f90)\nSAVE loop bounds", fillcolor="#fbb4ae"];
        cc_data -> blocker_save_ccdata [label="contains", color=red, style=dashed];
    }

    // =========================================================================
    // Connections to blockers
    // =========================================================================
    mass_orch -> blocker_ptm [label="uses", color=red, style=dashed];
    velo_orch -> blocker_ptm [label="uses", color=red, style=dashed];
    divg_orch -> blocker_ptm [label="uses", color=red, style=dashed];
    pres_orch -> blocker_ptm [label="uses", color=red, style=dashed];
    turb_orch -> blocker_ptm [label="uses", color=red, style=dashed];
    wall_orch -> blocker_ptm [label="uses", color=red, style=dashed];
    rad -> blocker_ptm [label="uses", color=red, style=dashed];
    part -> blocker_ptm [label="uses", color=red, style=dashed];
    soot -> blocker_ptm [label="uses", color=red, style=dashed];
    vege -> blocker_ptm [label="uses", color=red, style=dashed];

    // =========================================================================
    // Parallelization readiness summary
    // =========================================================================
    subgraph cluster_summary {
        label="Parallelization Readiness Summary";
        style=filled; fillcolor="#f8f8f8";
        rank=same;

        ready [label="READY (kernel extracted):\nvelo_kernels, divg_kernels,\nmass_kernels, pres_kernels,\nfire_kernels, turb_kernels,\nwall_kernels, pois,\ncc_*_kernels\n(10 kernel modules)", fillcolor="#b3e2cd"];

        needs_refactor [label="NEEDS REFACTORING:\nOrchestration wrappers:\nvelo, divg, mass, pres,\nfire, turb, wall,\ncc_divergence, cc_velocity,\ncc_pressure, cc_density\n(thin wrappers, tractable)", fillcolor="#fff2ae"];

        major_work [label="MAJOR WORK NEEDED:\npart.f90 (particles)\nradi.f90 (radiation)\ngeom.f90 (complex geometry)\nsoot.f90 (agglomeration)\nvege.f90 (level-set)\nhvac.f90 (HVAC, rank 0)\n(deep POINT_TO_MESH usage)", fillcolor="#fbb4ae"];

        ready -> needs_refactor -> major_work [style=invis];
    }
}
