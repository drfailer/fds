// FDS Module Dependency Graph
// Render: dot -Tsvg module_dependencies.dot -o module_dependencies.svg
//    or:  dot -Tpng module_dependencies.dot -o module_dependencies.png
//
// Layers are organized bottom-up: foundation at bottom, driver at top.
// Edge direction: A -> B means "A depends on (USEs) B".

digraph fds_modules {
    rankdir=BT;          // bottom-to-top layout
    compound=true;
    fontname="Helvetica";
    node [fontname="Helvetica", fontsize=10, shape=box, style=filled];
    edge [fontsize=8, color="#666666"];
    label="FDS Module Dependency Graph\n(A -> B means A USEs B)";
    labelloc=t;
    fontsize=14;

    // =========================================================================
    // Layer 0: Foundation
    // =========================================================================
    subgraph cluster_foundation {
        label="Layer 0: Foundation";
        style=filled; fillcolor="#f0f0f0";
        PRECISION_PARAMETERS [fillcolor="#b3e2cd", label="PRECISION_PARAMETERS\n(prec.f90)"];
        MPI_F08             [fillcolor="#b3e2cd", label="MPI_F08\n(external)"];
        ISO_C_BINDING       [fillcolor="#b3e2cd", label="ISO_C_BINDING\n(intrinsic)"];
    }

    // =========================================================================
    // Layer 1: Constants
    // =========================================================================
    subgraph cluster_constants {
        label="Layer 1: Constants";
        style=filled; fillcolor="#e8e8e8";
        GLOBAL_CONSTANTS [fillcolor="#fdcdac", label="GLOBAL_CONSTANTS\n(cons.f90)"];
    }
    GLOBAL_CONSTANTS -> PRECISION_PARAMETERS;
    GLOBAL_CONSTANTS -> MPI_F08;

    // =========================================================================
    // Layer 2: Type definitions
    // =========================================================================
    subgraph cluster_types {
        label="Layer 2: Types";
        style=filled; fillcolor="#e0e0e0";
        TYPES [fillcolor="#fdcdac", label="TYPES\n(type.f90)\nAll derived types"];
        MKL_PARDISO     [fillcolor="#d9d9d9", label="MKL_PARDISO\n(imkl.f90)"];
        HYPRE_INTERFACE [fillcolor="#d9d9d9", label="HYPRE_INTERFACE\n(imkl.f90)"];
    }
    TYPES -> PRECISION_PARAMETERS;
    TYPES -> GLOBAL_CONSTANTS [label="IAXIS,JAXIS,\nKAXIS only"];
    TYPES -> MKL_PARDISO [style=dashed, label="conditional"];
    TYPES -> HYPRE_INTERFACE [style=dashed, label="conditional"];

    // =========================================================================
    // Layer 3: Mesh
    // =========================================================================
    subgraph cluster_mesh {
        label="Layer 3: Mesh";
        style=filled; fillcolor="#d8d8d8";
        MESH_VARIABLES [fillcolor="#cbd5e8", label="MESH_VARIABLES\n(mesh.f90)\nMESH_TYPE definition\n+ MESH_POINTERS"];
    }
    MESH_VARIABLES -> PRECISION_PARAMETERS;
    MESH_VARIABLES -> TYPES;

    // =========================================================================
    // Layer 4: Utilities
    // =========================================================================
    subgraph cluster_utilities {
        label="Layer 4: Utilities";
        style=filled; fillcolor="#d0d0d0";
        COMP_FUNCTIONS      [fillcolor="#e6f5c9", label="COMP_FUNCTIONS\n(func.f90)"];
        OUTPUT_DATA         [fillcolor="#e6f5c9", label="OUTPUT_DATA\n(data.f90)\nQ_DOT, M_DOT"];
        MEMORY_FUNCTIONS    [fillcolor="#e6f5c9", label="MEMORY_FUNCTIONS\n(func.f90)"];
        MATH_FUNCTIONS      [fillcolor="#e6f5c9", label="MATH_FUNCTIONS\n(func.f90)"];
        PHYSICAL_FUNCTIONS  [fillcolor="#e6f5c9", label="PHYSICAL_FUNCTIONS\n(func.f90)"];
        MANUFACTURED_SOLUTIONS [fillcolor="#e6f5c9", label="MANUFACTURED_SOLUTIONS\n(func.f90)"];
        TRAN                [fillcolor="#e6f5c9", label="TRAN\n(func.f90)"];
        DEVICE_VARIABLES    [fillcolor="#e6f5c9", label="DEVICE_VARIABLES\n(devc.f90)"];
        CONTROL_VARIABLES   [fillcolor="#e6f5c9", label="CONTROL_VARIABLES\n(ctrl.f90)"];
        THERMO_PROPS        [fillcolor="#e6f5c9", label="THERMO_PROPS\n(prop.f90)"];
        RADCAL_VAR          [fillcolor="#e6f5c9", label="RADCAL_VAR\n(rcal.f90)"];
        CHEMCONS            [fillcolor="#e6f5c9", label="CHEMCONS\n(chem.f90)"];
        POIS                [fillcolor="#e6f5c9", label="POIS\n(pois.f90)\nFFT Poisson solver"];
    }
    COMP_FUNCTIONS     -> PRECISION_PARAMETERS;
    OUTPUT_DATA        -> PRECISION_PARAMETERS;
    OUTPUT_DATA        -> GLOBAL_CONSTANTS;
    MATH_FUNCTIONS     -> PRECISION_PARAMETERS;
    PHYSICAL_FUNCTIONS -> PRECISION_PARAMETERS;
    DEVICE_VARIABLES   -> PRECISION_PARAMETERS;
    THERMO_PROPS       -> PRECISION_PARAMETERS;
    RADCAL_VAR         -> PRECISION_PARAMETERS;
    RADCAL_VAR         -> GLOBAL_CONSTANTS;
    CHEMCONS           -> PRECISION_PARAMETERS;
    POIS               -> PRECISION_PARAMETERS;

    // =========================================================================
    // Layer 5: Kernel modules (thread-safe, explicit MESH_TYPE argument)
    // =========================================================================
    subgraph cluster_kernels {
        label="Layer 5: Computation Kernels\n(thread-safe: explicit MESH_TYPE arg, no POINT_TO_MESH)";
        style=filled; fillcolor="#c8e8c8";

        VELO_KERNELS [fillcolor="#b3cde3", label="VELO_KERNELS\n(velo_kernels.f90)"];
        DIVG_KERNELS [fillcolor="#b3cde3", label="DIVG_KERNELS\n(divg_kernels.f90)"];
        MASS_KERNELS [fillcolor="#b3cde3", label="MASS_KERNELS\n(mass_kernels.f90)"];
        PRES_KERNELS [fillcolor="#b3cde3", label="PRES_KERNELS\n(pres_kernels.f90)"];
        FIRE_KERNELS [fillcolor="#b3cde3", label="FIRE_KERNELS\n(fire_kernels.f90)"];
        TURB_KERNELS [fillcolor="#b3cde3", label="TURB_KERNELS\n(turb_kernels.f90)"];
        WALL_KERNELS [fillcolor="#b3cde3", label="WALL_KERNELS\n(wall_kernels.f90)"];

        CC_DIVERGENCE_KERNELS [fillcolor="#b3cde3", label="CC_DIVERGENCE_KERNELS\n(ccib_divergence_kernels.f90)"];
        CC_VELOCITY_KERNELS   [fillcolor="#b3cde3", label="CC_VELOCITY_KERNELS\n(ccib_velocity_kernels.f90)"];
        CC_PRESSURE_KERNELS   [fillcolor="#b3cde3", label="CC_PRESSURE_KERNELS\n(ccib_pressure_kernels.f90)"];
    }

    // Kernel dependencies (all depend on foundation + MESH_VARIABLES + TYPES)
    VELO_KERNELS -> PRECISION_PARAMETERS;
    VELO_KERNELS -> GLOBAL_CONSTANTS;
    VELO_KERNELS -> MESH_VARIABLES;
    VELO_KERNELS -> TYPES;

    DIVG_KERNELS -> PRECISION_PARAMETERS;
    DIVG_KERNELS -> GLOBAL_CONSTANTS;
    DIVG_KERNELS -> MESH_VARIABLES;
    DIVG_KERNELS -> TYPES;
    DIVG_KERNELS -> MATH_FUNCTIONS;
    DIVG_KERNELS -> PHYSICAL_FUNCTIONS;
    DIVG_KERNELS -> TURB_KERNELS;
    DIVG_KERNELS -> CC_DIVERGENCE_KERNELS;
    DIVG_KERNELS -> CC_PRESSURE_KERNELS;
    DIVG_KERNELS -> CC_VELOCITY_KERNELS;

    MASS_KERNELS -> PRECISION_PARAMETERS;
    MASS_KERNELS -> GLOBAL_CONSTANTS;
    MASS_KERNELS -> MESH_VARIABLES;
    MASS_KERNELS -> TYPES;
    MASS_KERNELS -> MATH_FUNCTIONS;
    MASS_KERNELS -> PHYSICAL_FUNCTIONS;

    PRES_KERNELS -> PRECISION_PARAMETERS;
    PRES_KERNELS -> GLOBAL_CONSTANTS;
    PRES_KERNELS -> MESH_VARIABLES;
    PRES_KERNELS -> TYPES;
    PRES_KERNELS -> MATH_FUNCTIONS;

    FIRE_KERNELS -> PRECISION_PARAMETERS;
    FIRE_KERNELS -> GLOBAL_CONSTANTS;
    FIRE_KERNELS -> TYPES;

    TURB_KERNELS -> PRECISION_PARAMETERS;
    TURB_KERNELS -> GLOBAL_CONSTANTS;
    TURB_KERNELS -> MESH_VARIABLES;

    WALL_KERNELS -> PRECISION_PARAMETERS;
    WALL_KERNELS -> GLOBAL_CONSTANTS;
    WALL_KERNELS -> MESH_VARIABLES;
    WALL_KERNELS -> TYPES;

    CC_DIVERGENCE_KERNELS -> PRECISION_PARAMETERS;
    CC_DIVERGENCE_KERNELS -> GLOBAL_CONSTANTS;
    CC_DIVERGENCE_KERNELS -> MESH_VARIABLES;
    CC_DIVERGENCE_KERNELS -> TYPES;
    CC_DIVERGENCE_KERNELS -> MATH_FUNCTIONS;

    CC_VELOCITY_KERNELS -> PRECISION_PARAMETERS;
    CC_VELOCITY_KERNELS -> GLOBAL_CONSTANTS;
    CC_VELOCITY_KERNELS -> MESH_VARIABLES;
    CC_VELOCITY_KERNELS -> TYPES;

    CC_PRESSURE_KERNELS -> PRECISION_PARAMETERS;
    CC_PRESSURE_KERNELS -> GLOBAL_CONSTANTS;
    CC_PRESSURE_KERNELS -> MESH_VARIABLES;
    CC_PRESSURE_KERNELS -> TYPES;

    // =========================================================================
    // Layer 6: Orchestration modules (use MESH_POINTERS / POINT_TO_MESH)
    // =========================================================================
    subgraph cluster_orchestration {
        label="Layer 6: Orchestration\n(use POINT_TO_MESH - NOT thread-safe)";
        style=filled; fillcolor="#ffe0e0";

        VELO        [fillcolor="#fbb4ae", label="VELO\n(velo.f90)"];
        DIVG        [fillcolor="#fbb4ae", label="DIVG\n(divg.f90)"];
        MASS        [fillcolor="#fbb4ae", label="MASS\n(mass.f90)"];
        PRES        [fillcolor="#fbb4ae", label="PRES\n(pres.f90)"];
        FIRE        [fillcolor="#fbb4ae", label="FIRE\n(fire.f90)"];
        TURBULENCE  [fillcolor="#fbb4ae", label="TURBULENCE\n(turb.f90)"];
        WALL_ROUTINES [fillcolor="#fbb4ae", label="WALL_ROUTINES\n(wall.f90)"];

        CC_DIVERGENCE [fillcolor="#fbb4ae", label="CC_DIVERGENCE\n(ccib_divergence.f90)"];
        CC_VELOCITY   [fillcolor="#fbb4ae", label="CC_VELOCITY\n(ccib_velocity.f90)"];
        CC_PRESSURE   [fillcolor="#fbb4ae", label="CC_PRESSURE\n(ccib_pressure.f90)"];
        CC_SCALARS    [fillcolor="#fbb4ae", label="CC_SCALARS\n(ccib.f90)"];
        CC_DENSITY_MOD [fillcolor="#fbb4ae", label="CC_DENSITY_MOD\n(ccib_density.f90)"];
    }

    // Orchestration -> Kernel edges
    VELO -> VELO_KERNELS;
    DIVG -> DIVG_KERNELS;
    MASS -> MASS_KERNELS;
    PRES -> PRES_KERNELS;
    FIRE -> FIRE_KERNELS;
    WALL_ROUTINES -> WALL_KERNELS;
    CC_DIVERGENCE -> CC_DIVERGENCE_KERNELS;
    CC_VELOCITY   -> CC_VELOCITY_KERNELS;
    CC_PRESSURE   -> CC_PRESSURE_KERNELS;

    // Orchestration -> Mesh pointers
    VELO -> MESH_VARIABLES;
    VELO -> GLOBAL_CONSTANTS;
    VELO -> COMP_FUNCTIONS;

    DIVG -> MESH_VARIABLES;
    DIVG -> GLOBAL_CONSTANTS;
    DIVG -> COMP_FUNCTIONS;

    MASS -> MESH_VARIABLES;
    MASS -> GLOBAL_CONSTANTS;
    MASS -> COMP_FUNCTIONS;

    PRES -> MESH_VARIABLES;
    PRES -> POIS;

    FIRE -> MESH_VARIABLES;
    FIRE -> GLOBAL_CONSTANTS;
    FIRE -> COMP_FUNCTIONS;
    FIRE -> CHEMCONS;

    TURBULENCE -> MESH_VARIABLES;
    TURBULENCE -> GLOBAL_CONSTANTS;
    TURBULENCE -> COMP_FUNCTIONS;

    WALL_ROUTINES -> MESH_VARIABLES;
    WALL_ROUTINES -> GLOBAL_CONSTANTS;
    WALL_ROUTINES -> COMP_FUNCTIONS;
    WALL_ROUTINES -> TURB_KERNELS;
    WALL_ROUTINES -> PHYSICAL_FUNCTIONS;
    WALL_ROUTINES -> CC_SCALARS;

    CC_DIVERGENCE -> MESH_VARIABLES;
    CC_VELOCITY   -> MESH_VARIABLES;
    CC_PRESSURE   -> MESH_VARIABLES;
    CC_SCALARS    -> MESH_VARIABLES;
    CC_DENSITY_MOD -> MESH_VARIABLES;

    // =========================================================================
    // Layer 7: Physics modules (complex, deep POINT_TO_MESH usage)
    // =========================================================================
    subgraph cluster_physics {
        label="Layer 7: Physics\n(deep POINT_TO_MESH usage)";
        style=filled; fillcolor="#ffe0e0";

        RAD           [fillcolor="#fbb4ae", label="RAD\n(radi.f90)\nRadiation transport"];
        PART          [fillcolor="#fbb4ae", label="PART\n(part.f90)\nLagrangian particles"];
        HVAC_ROUTINES [fillcolor="#fbb4ae", label="HVAC_ROUTINES\n(hvac.f90)\nRank 0 only"];
        SOOT_ROUTINES [fillcolor="#fbb4ae", label="SOOT_ROUTINES\n(soot.f90)"];
        VEGE          [fillcolor="#fbb4ae", label="VEGE\n(vege.f90)\nLevel-set fire spread"];
        COMPLEX_GEOMETRY [fillcolor="#fbb4ae", label="COMPLEX_GEOMETRY\n(geom.f90)\n32 SAVE vars"];
    }

    RAD -> MESH_VARIABLES;
    RAD -> GLOBAL_CONSTANTS;
    RAD -> RADCAL_VAR;
    RAD -> THERMO_PROPS;
    RAD -> TYPES;

    PART -> MESH_VARIABLES;
    PART -> GLOBAL_CONSTANTS;
    PART -> COMP_FUNCTIONS;
    PART -> MATH_FUNCTIONS;
    PART -> PHYSICAL_FUNCTIONS;

    HVAC_ROUTINES -> MESH_VARIABLES;
    HVAC_ROUTINES -> GLOBAL_CONSTANTS;
    HVAC_ROUTINES -> DEVICE_VARIABLES;
    HVAC_ROUTINES -> CONTROL_VARIABLES;
    HVAC_ROUTINES -> COMP_FUNCTIONS;

    SOOT_ROUTINES -> MESH_VARIABLES;
    SOOT_ROUTINES -> GLOBAL_CONSTANTS;
    SOOT_ROUTINES -> PHYSICAL_FUNCTIONS;

    VEGE -> MESH_VARIABLES;
    VEGE -> GLOBAL_CONSTANTS;
    VEGE -> COMP_FUNCTIONS;

    COMPLEX_GEOMETRY -> MESH_VARIABLES;
    COMPLEX_GEOMETRY -> GLOBAL_CONSTANTS;
    COMPLEX_GEOMETRY -> COMP_FUNCTIONS;
    COMPLEX_GEOMETRY -> MPI_F08;

    // =========================================================================
    // Layer 8: I/O
    // =========================================================================
    subgraph cluster_io {
        label="Layer 8: I/O & Setup";
        style=filled; fillcolor="#c8c8c8";
        READ_INPUT [fillcolor="#decbe4", label="READ_INPUT\n(read.f90)"];
        INIT       [fillcolor="#decbe4", label="INIT\n(init.f90)"];
        DUMP       [fillcolor="#decbe4", label="DUMP\n(dump.f90)"];
    }
    READ_INPUT -> MESH_VARIABLES;
    READ_INPUT -> GLOBAL_CONSTANTS;
    READ_INPUT -> COMP_FUNCTIONS;
    READ_INPUT -> OUTPUT_DATA;
    READ_INPUT -> HVAC_ROUTINES;
    READ_INPUT -> COMPLEX_GEOMETRY;
    READ_INPUT -> THERMO_PROPS;

    INIT -> MESH_VARIABLES;
    INIT -> GLOBAL_CONSTANTS;
    INIT -> OUTPUT_DATA;
    INIT -> MEMORY_FUNCTIONS;
    INIT -> DEVICE_VARIABLES;

    DUMP -> MESH_VARIABLES;
    DUMP -> GLOBAL_CONSTANTS;
    DUMP -> OUTPUT_DATA;
    DUMP -> DEVICE_VARIABLES;
    DUMP -> CONTROL_VARIABLES;
    DUMP -> COMPLEX_GEOMETRY;
    DUMP -> CC_SCALARS;
    DUMP -> COMP_FUNCTIONS;

    // =========================================================================
    // Layer 9: Driver
    // =========================================================================
    subgraph cluster_driver {
        label="Layer 9: Driver";
        style=filled; fillcolor="#c0c0c0";
        MAIN       [fillcolor="#ccebc5", label="PROGRAM FDS\n(main.f90)", shape=doubleoctagon];
        FDS_DRIVER [fillcolor="#ccebc5", label="FDS_DRIVER\n(fds_driver.f90)"];
        FDS_C_INTERFACE [fillcolor="#ccebc5", label="FDS_C_INTERFACE\n(fds_c_interface.f90)"];
    }

    MAIN -> READ_INPUT;
    MAIN -> INIT;
    MAIN -> DUMP;
    MAIN -> VELO;
    MAIN -> DIVG;
    MAIN -> MASS;
    MAIN -> PRES;
    MAIN -> FIRE;
    MAIN -> TURBULENCE;
    MAIN -> WALL_ROUTINES;
    MAIN -> RAD;
    MAIN -> PART;
    MAIN -> HVAC_ROUTINES;
    MAIN -> VEGE;
    MAIN -> CC_SCALARS;
    MAIN -> CC_VELOCITY;
    MAIN -> CC_DENSITY_MOD;
    MAIN -> SOOT_ROUTINES;
    MAIN -> MPI_F08;
    MAIN -> OUTPUT_DATA;
    MAIN -> DEVICE_VARIABLES;
    MAIN -> CONTROL_VARIABLES [label="CONTROL_FUNCTIONS"];

    FDS_DRIVER -> MAIN [style=dashed, label="same deps"];
    FDS_C_INTERFACE -> FDS_DRIVER;
    FDS_C_INTERFACE -> ISO_C_BINDING;

    // =========================================================================
    // Cross-layer dependencies (notable)
    // =========================================================================
    DIVG_KERNELS -> MANUFACTURED_SOLUTIONS [style=dashed];
    FIRE_KERNELS -> CHEMCONS [label="CVODE"];
    CC_SCALARS -> CC_DIVERGENCE;
    CC_VELOCITY -> CC_SCALARS;
    CC_VELOCITY -> CC_DIVERGENCE;
    CC_PRESSURE -> CC_SCALARS;
    CC_PRESSURE -> CC_DIVERGENCE;
    CC_DENSITY_MOD -> CC_SCALARS [style=dashed, label="CC_SCALARS_DATA"];
}
