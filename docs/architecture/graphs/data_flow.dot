// FDS Data Flow - Key Variables Through One Time Step
// Render: dot -Tsvg data_flow.dot -o data_flow.svg
//
// Shows how the major field variables (3D/4D arrays in MESH_TYPE) are
// produced and consumed by the computation routines.
//
// Rounded boxes = computation routines
// Parallelograms = data arrays (field variables)
// Colors: blue = velocity, green = density/species, orange = pressure,
//         red = heat/combustion, purple = radiation

digraph data_flow {
    rankdir=LR;
    fontname="Helvetica";
    node [fontname="Helvetica", fontsize=9];
    edge [fontsize=8];
    label="FDS Data Flow: Major Variables Through One Time Step";
    labelloc=t;
    fontsize=14;
    compound=true;

    // =========================================================================
    // Field variable nodes (parallelogram shape)
    // =========================================================================

    // Velocity fields (blue)
    subgraph cluster_velocity_data {
        label="Velocity Fields";
        style=filled; fillcolor="#e8f0ff";
        U_V_W     [label="U, V, W\n(current velocity)", shape=parallelogram, fillcolor="#b3cde3"];
        US_VS_WS  [label="US, VS, WS\n(predicted velocity)", shape=parallelogram, fillcolor="#b3cde3"];
        FVX_FVY_FVZ [label="FVX, FVY, FVZ\n(momentum flux)", shape=parallelogram, fillcolor="#b3cde3"];
        KRES      [label="KRES\n(kinetic energy)", shape=parallelogram, fillcolor="#b3cde3"];
    }

    // Density/species fields (green)
    subgraph cluster_density_data {
        label="Density / Species Fields";
        style=filled; fillcolor="#e8ffe8";
        RHO_ZZ    [label="RHO, ZZ\n(density, species)", shape=parallelogram, fillcolor="#b3e2cd"];
        RHOS_ZZS  [label="RHOS, ZZS\n(predicted)", shape=parallelogram, fillcolor="#b3e2cd"];
        TMP       [label="TMP\n(temperature)", shape=parallelogram, fillcolor="#b3e2cd"];
        FX_FY_FZ  [label="FX, FY, FZ\n(species flux)", shape=parallelogram, fillcolor="#b3e2cd"];
        DEL_RHO   [label="DEL_RHO_D_DEL_Z\n(diffusive flux)", shape=parallelogram, fillcolor="#b3e2cd"];
    }

    // Pressure fields (orange)
    subgraph cluster_pressure_data {
        label="Pressure Fields";
        style=filled; fillcolor="#fff8e8";
        H_HS      [label="H, HS\n(pressure head:\np'/rho + |u|^2/2)", shape=parallelogram, fillcolor="#fdcdac"];
        D_DS      [label="D, DS\n(divergence)", shape=parallelogram, fillcolor="#fdcdac"];
        DDDT      [label="DDDT\n(divergence rate)", shape=parallelogram, fillcolor="#fdcdac"];
        PRHS      [label="PRHS\n(Poisson RHS)", shape=parallelogram, fillcolor="#fdcdac"];
        PBAR      [label="PBAR\n(background pressure)", shape=parallelogram, fillcolor="#fdcdac"];
    }

    // Turbulence (teal)
    MU [label="MU\n(turbulent viscosity)", shape=parallelogram, fillcolor="#ccece6"];

    // Combustion fields (red)
    subgraph cluster_combustion_data {
        label="Combustion / Source Fields";
        style=filled; fillcolor="#ffe8e8";
        Q         [label="Q\n(heat release rate)", shape=parallelogram, fillcolor="#fbb4ae"];
        REAC_SRC  [label="REAC_SOURCE_TERM\n(reaction sources)", shape=parallelogram, fillcolor="#fbb4ae"];
        M_DOT_PPP [label="M_DOT_PPP\n(particle mass source)", shape=parallelogram, fillcolor="#fbb4ae"];
    }

    // Radiation (purple)
    subgraph cluster_radiation_data {
        label="Radiation Fields";
        style=filled; fillcolor="#f0e8ff";
        QR        [label="QR, QR_W\n(radiation source)", shape=parallelogram, fillcolor="#decbe4"];
    }

    // Wall data
    WALL_DATA [label="WALL / BOUNDARY_*\n(surface T, fluxes,\nmass transfer)", shape=parallelogram, fillcolor="#d9d9d9"];

    // =========================================================================
    // Computation routine nodes (rounded boxes)
    // =========================================================================

    COMPUTE_VISCOSITY [label="COMPUTE_VISCOSITY\n(turb.f90)", shape=box, style="filled,rounded", fillcolor="#f0f0f0"];
    MASS_FD [label="MASS_FINITE_\nDIFFERENCES_NEW\n(mass.f90)", shape=box, style="filled,rounded", fillcolor="#f0f0f0"];
    DENSITY [label="DENSITY\n(mass.f90)", shape=box, style="filled,rounded", fillcolor="#f0f0f0"];
    VELOCITY_FLUX [label="VELOCITY_FLUX\n(velo.f90)", shape=box, style="filled,rounded", fillcolor="#f0f0f0"];
    WALL_BC [label="WALL_BC\n(wall.f90)", shape=box, style="filled,rounded", fillcolor="#f0f0f0"];
    DIV_PART_1 [label="DIVERGENCE_\nPART_1\n(divg.f90)", shape=box, style="filled,rounded", fillcolor="#f0f0f0"];
    DIV_PART_2 [label="DIVERGENCE_\nPART_2\n(divg.f90)", shape=box, style="filled,rounded", fillcolor="#f0f0f0"];
    PRES_RHS [label="PRESSURE_SOLVER_\nCOMPUTE_RHS\n(pres.f90)", shape=box, style="filled,rounded", fillcolor="#f0f0f0"];
    PRES_FFT [label="PRESSURE_SOLVER_FFT\n(pres.f90)", shape=box, style="filled,rounded", fillcolor="#f0f0f0"];
    VEL_PRED [label="VELOCITY_\nPREDICTOR\n(velo.f90)", shape=box, style="filled,rounded", fillcolor="#f0f0f0"];
    VEL_CORR [label="VELOCITY_\nCORRECTOR\n(velo.f90)", shape=box, style="filled,rounded", fillcolor="#f0f0f0"];
    COMBUSTION [label="COMBUSTION_\nLOAD_BALANCED\n(fire.f90)", shape=box, style="filled,rounded", fillcolor="#f0f0f0"];
    RADIATION [label="COMPUTE_\nRADIATION\n(radi.f90)", shape=box, style="filled,rounded", fillcolor="#f0f0f0"];
    PART_TRANSFER [label="PARTICLE_MASS_\nENERGY_TRANSFER\n(part.f90)", shape=box, style="filled,rounded", fillcolor="#f0f0f0"];
    EOS [label="Equation\nof State\n(in DENSITY)", shape=box, style="filled,rounded", fillcolor="#f0f0f0"];

    // =========================================================================
    // Data flow edges (input -> routine -> output)
    // =========================================================================

    // COMPUTE_VISCOSITY: U,V,W -> MU
    U_V_W -> COMPUTE_VISCOSITY [label="velocity\nfield"];
    COMPUTE_VISCOSITY -> MU;

    // MASS_FINITE_DIFFERENCES: ZZ,RHO,U,V,W -> FX,FY,FZ, DEL_RHO_D_DEL_Z
    RHO_ZZ -> MASS_FD [label="species"];
    U_V_W -> MASS_FD [label="advection"];
    MU -> MASS_FD [label="diffusion coeff"];
    MASS_FD -> FX_FY_FZ;
    MASS_FD -> DEL_RHO;

    // DENSITY: FX,FY,FZ,DEL_RHO -> RHOS,ZZS (predictor) or RHO,ZZ (corrector)
    FX_FY_FZ -> DENSITY;
    DEL_RHO -> DENSITY;
    REAC_SRC -> DENSITY [label="reaction\nsources", style=dashed];
    M_DOT_PPP -> DENSITY [label="particle\nsources", style=dashed];
    DENSITY -> RHOS_ZZS [label="predictor"];
    DENSITY -> RHO_ZZ [label="corrector", style=dashed];

    // EOS: RHOS,ZZS,PBAR -> TMP
    RHOS_ZZS -> EOS;
    PBAR -> EOS;
    EOS -> TMP;

    // VELOCITY_FLUX: U,V,W,MU -> FVX,FVY,FVZ
    U_V_W -> VELOCITY_FLUX;
    MU -> VELOCITY_FLUX [label="viscous\nstress"];
    VELOCITY_FLUX -> FVX_FVY_FVZ;

    // WALL_BC: TMP,ZZS -> WALL_DATA (surface conditions)
    TMP -> WALL_BC;
    RHOS_ZZS -> WALL_BC;
    WALL_BC -> WALL_DATA;

    // COMBUSTION: ZZ, TMP -> Q, REAC_SOURCE_TERM
    RHO_ZZ -> COMBUSTION [label="species"];
    TMP -> COMBUSTION [label="temperature"];
    COMBUSTION -> Q;
    COMBUSTION -> REAC_SRC;

    // PARTICLE_TRANSFER: particles + gas -> M_DOT_PPP, FVX_D
    TMP -> PART_TRANSFER;
    RHO_ZZ -> PART_TRANSFER;
    U_V_W -> PART_TRANSFER;
    PART_TRANSFER -> M_DOT_PPP;

    // RADIATION: TMP, ZZ, KAPPA -> QR
    TMP -> RADIATION;
    RHO_ZZ -> RADIATION [label="absorption\ncoeffs"];
    WALL_DATA -> RADIATION [label="surface\nemissivity"];
    RADIATION -> QR;

    // DIVERGENCE_PART_1: Q,QR,M_DOT_PPP,TMP,ZZ,PBAR,WALL -> D
    Q -> DIV_PART_1 [label="heat release"];
    QR -> DIV_PART_1 [label="rad source"];
    M_DOT_PPP -> DIV_PART_1 [label="mass source"];
    TMP -> DIV_PART_1;
    WALL_DATA -> DIV_PART_1 [label="boundary\nfluxes"];
    PBAR -> DIV_PART_1 [label="background\npressure"];
    DIV_PART_1 -> D_DS;

    // DIVERGENCE_PART_2: D -> DDDT
    D_DS -> DIV_PART_2;
    DIV_PART_2 -> DDDT;

    // PRESSURE_SOLVER_COMPUTE_RHS: DDDT, FVX -> PRHS
    DDDT -> PRES_RHS;
    FVX_FVY_FVZ -> PRES_RHS;
    PRES_RHS -> PRHS;

    // PRESSURE_SOLVER_FFT: PRHS -> H
    PRHS -> PRES_FFT;
    PRES_FFT -> H_HS;

    // VELOCITY_PREDICTOR: U,FVX,H,RHO -> US
    U_V_W -> VEL_PRED;
    FVX_FVY_FVZ -> VEL_PRED;
    H_HS -> VEL_PRED [label="pressure\ngradient"];
    RHOS_ZZS -> VEL_PRED [label="density"];
    VEL_PRED -> US_VS_WS;

    // VELOCITY_CORRECTOR: U,US,H,RHO -> U (final)
    US_VS_WS -> VEL_CORR;
    U_V_W -> VEL_CORR [style=dashed];
    H_HS -> VEL_CORR [label="corrected\npressure"];
    VEL_CORR -> U_V_W [label="final\nvelocity", color=blue, penwidth=2];
}
